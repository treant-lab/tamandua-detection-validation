{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.io/schemas/maki_authorized_download_execution_plan_v1.schema.json",
  "type": "object",
  "required": ["api_version", "status", "source_dry_run_plan", "download_allowed", "authorization_id", "authorization_nonce", "authorization_expires_at", "bucket_allowlist", "maximum_object_bytes", "maximum_total_bytes", "object_count", "estimated_total_bytes", "objects", "execution", "plan_sha256"],
  "properties": {
    "api_version": {"const": "tamandua.io/maki-authorized-download-execution-plan/v1"},
    "status": {"const": "authorized_not_executed"},
    "download_allowed": {"const": true},
    "authorization_id": {"type": "string", "minLength": 1},
    "authorization_nonce": {"type": "string", "minLength": 16},
    "authorization_expires_at": {"type": "string", "format": "date-time"},
    "source_dry_run_plan": {"$ref": "#/$defs/source"},
    "bucket_allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "maximum_object_bytes": {"const": 50000000},
    "maximum_total_bytes": {"type": "integer", "minimum": 0},
    "object_count": {"type": "integer", "minimum": 0},
    "estimated_total_bytes": {"type": "integer", "minimum": 0},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
    "execution": {"const": {"downloads_performed": false, "uses_etag_as_sha256": false}},
    "plan_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"type": "object", "required": ["path", "file_sha256", "plan_sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "file_sha256": {"$ref": "#/$defs/sha"}, "plan_sha256": {"$ref": "#/$defs/sha"}}, "additionalProperties": false},
    "object": {"type": "object", "required": ["sha256", "split", "expected_size_bytes", "bucket", "object_key", "version_id", "downstream_bytes_sha256_revalidation"], "properties": {"sha256": {"$ref": "#/$defs/sha"}, "split": {"enum": ["train", "calibration"]}, "expected_size_bytes": {"type": "integer", "minimum": 0, "maximum": 50000000}, "bucket": {"type": "string", "minLength": 1}, "object_key": {"type": "string", "minLength": 1}, "version_id": {"type": "string", "minLength": 1}, "downstream_bytes_sha256_revalidation": {"const": true}}, "additionalProperties": false}
  },
  "additionalProperties": true
}
