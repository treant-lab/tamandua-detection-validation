{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/mobile_native_artifact_hardening_receipt_v1.schema.json",
  "title": "Tamandua mobile native artifact hardening receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "schema_id", "state", "android_aar", "android_libraries", "ios_xcframework", "authority", "claims", "blockers"],
  "properties": {
    "receipt_id": {"type": "string", "pattern": "^tmnh_v1_[0-9a-f]{64}$"},
    "schema_id": {"const": "tamandua.mobile_native_artifact_hardening_receipt/v1"},
    "state": {"enum": ["passed", "hold", "failed"]},
    "android_aar": {"$ref": "#/$defs/file"},
    "android_libraries": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/library"}},
    "ios_xcframework": {"$ref": "#/$defs/xcframework"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_tool", "receipt_schema", "hardening_verifier", "policy_sha256", "source_boundary"],
      "properties": {
        "receipt_tool": {"$ref": "#/$defs/file"}, "receipt_schema": {"$ref": "#/$defs/file"},
        "hardening_verifier": {"$ref": "#/$defs/file"}, "policy_sha256": {"$ref": "#/$defs/sha"},
        "source_boundary": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/file"}}
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["android_final_package_shared_library_hardening", "ios_final_link_hardening", "native_execution_observed", "reproducible_build", "release_ready", "external_claim_allowed"],
      "properties": {
        "android_final_package_shared_library_hardening": {"type": "boolean"},
        "ios_final_link_hardening": {"const": false}, "native_execution_observed": {"const": false},
        "reproducible_build": {"const": false}, "release_ready": {"const": false}, "external_claim_allowed": {"const": false}
      }
    },
    "blockers": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 96}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\u007f\\\\]+$", "maxLength": 512},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha"}, "size": {"type": "integer", "minimum": 1, "maximum": 4294967296}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["name", "requirement", "state", "detail"], "properties": {"name": {"type": "string"}, "requirement": {"enum": ["required", "advisory"]}, "state": {"enum": ["pass", "fail", "not_detected"]}, "detail": {"type": "string"}}},
    "library": {
      "type": "object", "additionalProperties": false,
      "required": ["archive_path", "sha256", "size", "target", "format", "arch", "state", "checks", "limitations"],
      "properties": {
        "archive_path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha"}, "size": {"type": "integer", "minimum": 1},
        "target": {"enum": ["aarch64-unknown-linux-gnu", "armv7-unknown-linux-gnueabihf", "x86_64-unknown-linux-gnu"]},
        "format": {"const": "elf"}, "arch": {"type": "string"}, "state": {"enum": ["passed", "failed"]},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "xcframework": {
      "type": "object", "additionalProperties": false, "required": ["path", "state", "inventory_sha256", "inventory"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "state": {"enum": ["present", "missing", "invalid"]},
        "inventory_sha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "inventory": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/file"}}
      }
    }
  }
}
