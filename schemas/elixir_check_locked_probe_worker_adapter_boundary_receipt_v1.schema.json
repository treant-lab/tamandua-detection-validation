      "type": "object", "additionalProperties": false,
      "required": ["platform", "lifecycle_state", "containment_established", "termination_attempted", "exit_confirmed", "exit_code", "timed_out"],
      "properties": {
        "platform": { "enum": ["windows", "posix"] },
        "lifecycle_state": { "enum": ["not_spawned", "contained_exited", "contained_exit_unconfirmed", "uncontained_exited", "uncontained_exit_unconfirmed"] },
        "containment_established": { "type": "boolean" }, "termination_attempted": { "type": "boolean" },
        "exit_confirmed": { "type": "boolean" }, "exit_code": { "oneOf": [{ "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }, { "type": "null" }] },
        "timed_out": { "type": "boolean" }
      }
    },
    "observation": { "$ref": "#/$defs/unobserved" },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["stdin_canonical", "stdout_canonical", "stdout_observation_complete", "stderr_observation_complete", "stderr_seen", "output_limit_exceeded", "stream_read_error_seen", "stdin_write_error_seen", "accepted_output_bytes", "accepted_stdout_bytes", "accepted_stderr_bytes", "accepted_output_max_bytes", "request_sha256", "response_sha256"],
      "properties": {
        "stdin_canonical": { "type": "boolean" }, "stdout_canonical": { "type": "boolean" },
        "stdout_observation_complete": { "type": "boolean" }, "stderr_observation_complete": { "type": "boolean" },
        "stderr_seen": { "type": "boolean" }, "output_limit_exceeded": { "type": "boolean" },
        "stream_read_error_seen": { "type": "boolean" }, "stdin_write_error_seen": { "type": "boolean" },
        "accepted_output_bytes": { "type": "integer", "minimum": 0, "maximum": 32768 },
        "accepted_stdout_bytes": { "type": "integer", "minimum": 0, "maximum": 32768 },
        "accepted_stderr_bytes": { "type": "integer", "minimum": 0, "maximum": 32768 },
        "accepted_output_max_bytes": { "const": 32768 },
        "request_sha256": { "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
        "response_sha256": { "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] }
