        { "properties": { "process": { "properties": { "exit_code": { "not": { "const": 0 } } } } } }
      ]
    } }
  ],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "argv": { "type": "array", "minItems": 3, "maxItems": 96, "items": { "type": "string", "minLength": 1, "maxLength": 768 } },
    "mount": { "type": "object", "additionalProperties": false, "required": ["source", "source_sha256", "destination", "read_only"], "properties": { "source": { "type": "string", "minLength": 3, "maxLength": 512 }, "source_sha256": { "$ref": "#/$defs/sha" }, "destination": { "type": "string", "pattern": "^/tamandua-inputs/[a-f0-9]{64}/(?:server|contract)/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)?$" }, "read_only": { "const": true } } },
    "unobserved": { "const": { "pre_absence": "not_observed", "exact_resource_id": null, "cleanup_attempted": false, "cleanup_succeeded": null, "final_absence": "not_observed", "inventory_before_sha256": null, "inventory_after_sha256": null, "inventory_unchanged": null } },
    "claims": { "const": { "adapter_executed": false, "check_locked_executed": false, "external_claim_allowed": false, "product_ready": false, "production_ready": false, "real_cleanup_verified": false, "release_ready": false, "verimatrix_parity": false } }
  }
