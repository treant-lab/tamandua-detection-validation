{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/elixir_check_locked_probe_worker_adapter_boundary_receipt_v1.schema.json",
  "title": "Elixir check-locked source-only worker adapter boundary receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidence_class", "workspace_base_head", "invocation_id", "bindings", "plan", "execution", "process", "observation", "transport", "result", "claims"],
  "properties": {
    "schema": { "const": "tamandua.elixir_check_locked.worker_adapter_boundary_receipt/v1" },
    "evidence_class": { "const": "local_offline_source_only_container_adapter_contract" },
