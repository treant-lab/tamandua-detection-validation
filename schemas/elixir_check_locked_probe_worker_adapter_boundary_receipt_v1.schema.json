        "state_machine": { "const": ["pre_absence", "optional_exact_resource_id", "ownership_verified", "cleanup_attempted", "final_absence", "inventory_reconciled"] },
        "limits": { "const": { "total_timeout_ms": 5000, "cleanup_reserve_ms": 1500, "combined_output_max_bytes": 32768, "request_max_bytes": 65536, "response_max_bytes": 16384 } }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["double_spawn_count", "adapter_runs", "network_requests", "check_locked_runs"],
      "properties": {
