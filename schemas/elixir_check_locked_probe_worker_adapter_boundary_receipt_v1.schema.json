  "oneOf": [
    {
      "properties": {
        "result": { "const": { "status": "observed", "outcome": "source_only_not_executed", "error_class": null } },
        "execution": { "properties": { "double_spawn_count": { "const": 1 } } },
        "process": { "properties": { "lifecycle_state": { "const": "contained_exited" }, "containment_established": { "const": true }, "termination_attempted": { "const": false }, "exit_confirmed": { "const": true }, "exit_code": { "const": 0 }, "timed_out": { "const": false } } },
        "transport": { "properties": { "stdin_canonical": { "const": true }, "stdout_canonical": { "const": true }, "stdout_observation_complete": { "const": true }, "stderr_observation_complete": { "const": true }, "stderr_seen": { "const": false }, "output_limit_exceeded": { "const": false }, "stream_read_error_seen": { "const": false }, "stdin_write_error_seen": { "const": false }, "response_sha256": { "$ref": "#/$defs/sha" } } }
      }
    },
    {
      "properties": {
        "result": { "properties": { "status": { "const": "blocked" }, "outcome": { "const": "boundary_error" }, "error_class": { "type": "string" } } },
        "transport": { "properties": { "stdout_canonical": { "const": false }, "response_sha256": { "type": "null" } } }
      }
    }
  ],
  "allOf": [
    { "if": { "properties": { "process": { "properties": { "lifecycle_state": { "const": "not_spawned" } } } } }, "then": { "properties": { "process": { "properties": { "containment_established": { "const": false }, "termination_attempted": { "const": false }, "exit_confirmed": { "const": false }, "exit_code": { "const": null }, "timed_out": { "const": false } } } } } },
    { "if": { "properties": { "process": { "properties": { "lifecycle_state": { "const": "contained_exited" } } } } }, "then": { "properties": { "process": { "properties": { "containment_established": { "const": true }, "exit_confirmed": { "const": true }, "exit_code": { "type": "integer" } } } } } },
    { "if": { "properties": { "process": { "properties": { "lifecycle_state": { "const": "contained_exit_unconfirmed" } } } } }, "then": { "properties": { "process": { "properties": { "containment_established": { "const": true }, "exit_confirmed": { "const": false }, "exit_code": { "const": null } } } } } },
    { "if": { "properties": { "process": { "properties": { "lifecycle_state": { "const": "uncontained_exited" } } } } }, "then": { "properties": { "process": { "properties": { "containment_established": { "const": false }, "exit_confirmed": { "const": true }, "exit_code": { "type": "integer" } } } } } },
    { "if": { "properties": { "process": { "properties": { "lifecycle_state": { "const": "uncontained_exit_unconfirmed" } } } } }, "then": { "properties": { "process": { "properties": { "containment_established": { "const": false }, "exit_confirmed": { "const": false }, "exit_code": { "const": null } } } } } },
    { "if": { "properties": { "transport": { "properties": { "output_limit_exceeded": { "const": true } } } } }, "then": { "properties": { "transport": { "properties": { "accepted_output_bytes": { "const": 32768 } } } } } },
    { "if": { "properties": { "transport": { "properties": { "stderr_seen": { "const": false } } } } }, "then": { "properties": { "transport": { "properties": { "accepted_stderr_bytes": { "const": 0 } } } } } },
    { "if": { "properties": { "process": { "properties": { "termination_attempted": { "const": true } } } } }, "then": { "properties": { "result": { "properties": { "error_class": { "enum": ["worker_timeout", "stream_limit_exceeded", "stream_observation_incomplete", "process_setup_error"] } } } } } },
    { "if": { "properties": { "result": { "properties": { "error_class": { "const": "worker_timeout" } } } } }, "then": { "properties": { "process": { "properties": { "containment_established": { "const": true }, "timed_out": { "const": true }, "termination_attempted": { "const": true } } } } } },
    { "if": { "properties": { "result": { "properties": { "error_class": { "const": "stream_limit_exceeded" } } } } }, "then": { "properties": { "process": { "properties": { "containment_established": { "const": true }, "timed_out": { "const": false } } }, "transport": { "properties": { "output_limit_exceeded": { "const": true }, "accepted_output_bytes": { "const": 32768 } } } } } },
    { "if": { "properties": { "result": { "properties": { "error_class": { "const": "input_invalid" } } } } }, "then": { "properties": { "execution": { "properties": { "double_spawn_count": { "const": 0 } } }, "process": { "properties": { "lifecycle_state": { "const": "not_spawned" }, "containment_established": { "const": false }, "termination_attempted": { "const": false }, "exit_confirmed": { "const": false }, "exit_code": { "const": null }, "timed_out": { "const": false } } }, "transport": { "properties": { "stdin_canonical": { "const": false }, "stdout_canonical": { "const": false }, "stdout_observation_complete": { "const": false }, "stderr_observation_complete": { "const": false }, "stderr_seen": { "const": false }, "output_limit_exceeded": { "const": false }, "stream_read_error_seen": { "const": false }, "stdin_write_error_seen": { "const": false }, "accepted_output_bytes": { "const": 0 }, "accepted_stdout_bytes": { "const": 0 }, "accepted_stderr_bytes": { "const": 0 }, "request_sha256": { "const": null }, "response_sha256": { "const": null } } } } } },
    { "if": { "properties": { "result": { "properties": { "error_class": { "const": "stream_observation_incomplete" } } } } }, "then": { "anyOf": [
      { "properties": { "transport": { "properties": { "stdin_write_error_seen": { "const": true } } } } },
      { "properties": { "transport": { "properties": { "stream_read_error_seen": { "const": true } } } } },
      { "properties": { "transport": { "properties": { "stdout_observation_complete": { "const": false } } } } },
      { "properties": { "transport": { "properties": { "stderr_observation_complete": { "const": false } } } } }
    ], "properties": { "process": { "properties": { "containment_established": { "const": true }, "timed_out": { "const": false } } }, "transport": { "properties": { "output_limit_exceeded": { "const": false } } } } } },
    { "if": { "properties": { "result": { "properties": { "error_class": { "const": "process_setup_error" } } } } }, "then": { "anyOf": [
      { "properties": { "execution": { "properties": { "double_spawn_count": { "const": 0 } } }, "process": { "properties": { "lifecycle_state": { "const": "not_spawned" } } } } },
      { "properties": { "execution": { "properties": { "double_spawn_count": { "const": 1 } } }, "process": { "properties": { "termination_attempted": { "const": true } } } } }
    ], "properties": { "process": { "properties": { "timed_out": { "const": false } } }, "transport": { "const": { "stdin_canonical": false, "stdout_canonical": false, "stdout_observation_complete": false, "stderr_observation_complete": false, "stderr_seen": false, "output_limit_exceeded": false, "stream_read_error_seen": false, "stdin_write_error_seen": false, "accepted_output_bytes": 0, "accepted_stdout_bytes": 0, "accepted_stderr_bytes": 0, "accepted_output_max_bytes": 32768, "request_sha256": null, "response_sha256": null } } } } },
    { "if": { "properties": { "result": { "properties": { "error_class": { "enum": ["manifest_drift", "protocol_error"] } } } } }, "then": { "properties": {
      "execution": { "properties": { "double_spawn_count": { "const": 1 } } },
      "process": { "properties": { "containment_established": { "const": true }, "termination_attempted": { "const": false }, "exit_confirmed": { "const": true }, "exit_code": { "const": 0 }, "timed_out": { "const": false } } },
      "transport": { "properties": { "stdout_observation_complete": { "const": true }, "stderr_observation_complete": { "const": true }, "stderr_seen": { "const": false }, "output_limit_exceeded": { "const": false }, "stream_read_error_seen": { "const": false }, "stdin_write_error_seen": { "const": false } } }
    } } },
    { "if": { "properties": { "result": { "properties": { "error_class": { "const": "worker_error" } } } } }, "then": {
      "properties": {
        "execution": { "properties": { "double_spawn_count": { "const": 1 } } },
        "process": { "properties": { "containment_established": { "const": true }, "termination_attempted": { "const": false }, "exit_confirmed": { "const": true }, "timed_out": { "const": false } } },
        "transport": { "properties": { "stdout_observation_complete": { "const": true }, "stderr_observation_complete": { "const": true }, "output_limit_exceeded": { "const": false }, "stream_read_error_seen": { "const": false }, "stdin_write_error_seen": { "const": false } } }
      },
      "anyOf": [
