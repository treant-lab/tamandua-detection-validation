{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/macos_source_bundle_evidence_v6.schema.json",
  "title": "Tamandua macOS source bundle evidence v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "source",
    "toolchain",
    "sdk",
    "environment",
    "cache_environment",
    "provenance",
    "builds",
    "comparison",
    "divergence",
    "negative_control",
    "trust"
  ],
  "properties": {
    "schema_version": {
      "const": "tamandua.macos_source_bundle_evidence/v6"
    },
    "state": {
      "enum": [
        "pass",
        "mismatch",
        "blocked_stub",
        "supplied_artifact",
        "dirty_source",
        "invalid_negative_control"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "dirty",
        "dirty_patch_sha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "dirty_patch_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "cargo",
        "rustc",
        "swift"
      ]
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "endpoint_security_tbd_present",
        "endpoint_security_tbd_sha256"
      ],
      "properties": {
        "id": {
          "const": "macosx"
        },
        "version": {
          "type": "string"
        },
        "endpoint_security_tbd_present": {
          "type": "boolean"
        },
        "endpoint_security_tbd_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "endpoint_security_tbd_present": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "endpoint_security_tbd_sha256": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "endpoint_security_tbd_sha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SDKROOT",
        "MACOSX_DEPLOYMENT_TARGET",
        "RUSTFLAGS",
        "SOURCE_DATE_EPOCH"
      ],
      "properties": {
        "SDKROOT": {
          "$ref": "#/$defs/presence"
        },
        "MACOSX_DEPLOYMENT_TARGET": {
          "$ref": "#/$defs/presence"
        },
        "RUSTFLAGS": {
          "$ref": "#/$defs/presence"
        },
        "SOURCE_DATE_EPOCH": {
          "$ref": "#/$defs/presence"
        }
      }
    },
    "cache_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "swift_module_cache_path_inherited",
        "clang_module_cache_path_inherited",
        "removed_from_child_environment"
      ],
      "properties": {
        "swift_module_cache_path_inherited": {
          "type": "boolean"
        },
        "clang_module_cache_path_inherited": {
          "type": "boolean"
        },
        "removed_from_child_environment": {
          "const": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "locked",
        "scratch_isolated",
        "mach_o_normalized",
        "packager",
        "package_runs",
        "supplied_artifacts",
        "swift_reproducibility_candidate",
        "post_link_byte_rewrite",
        "macho_uuid_contract_architecture",
        "applied_controls",
        "module_cache_lifecycle",
        "swift_scratch_lifecycle"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "locked": {
          "type": "boolean"
        },
        "scratch_isolated": {
          "type": "boolean"
        },
        "mach_o_normalized": {
          "const": false
        },
        "packager": {
          "const": "apps/tamandua_agent/scripts/package_macos_system_extension_candidate.sh"
        },
        "package_runs": {
          "const": 2
        },
        "supplied_artifacts": {
          "type": "boolean"
        },
        "swift_reproducibility_candidate": {
          "const": true
        },
        "post_link_byte_rewrite": {
          "const": false
        },
        "macho_uuid_contract_architecture": {
          "const": "arm64"
        },
        "applied_controls": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 9,
          "items": {
            "enum": [
              "file_prefix_map",
              "scanner_prefix_map",
              "file_compilation_dir",
              "fixed_jobs",
              "disabled_swiftpm_caches",
              "reproducible_link",
              "module_cache_path",
              "clang_scanner_module_cache_path",
              "canonical_swift_scratch_path"
            ]
          }
        },
        "module_cache_lifecycle": {
          "anyOf": [
            {
              "$ref": "#/$defs/module_cache_lifecycle"
            },
            {
              "type": "null"
            }
          ]
        },
        "swift_scratch_lifecycle": {
          "anyOf": [
            {
              "$ref": "#/$defs/swift_scratch_lifecycle"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "supplied_artifacts": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "applied_controls": {
                "maxItems": 0
              },
              "module_cache_lifecycle": {
                "type": "null"
              },
              "swift_scratch_lifecycle": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "applied_controls": {
                "minItems": 9,
                "maxItems": 9
              },
              "module_cache_lifecycle": {
                "$ref": "#/$defs/module_cache_lifecycle"
              },
              "swift_scratch_lifecycle": {
                "$ref": "#/$defs/swift_scratch_lifecycle"
              }
            }
          }
        }
      ]
    },
    "builds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/build"
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rust_sha256_equal",
        "swift_tree_equal",
        "ordered_tree_equal",
        "swift_objects_equal",
        "swift_modules_equal",
        "endpoint_security_linked_both",
        "swift_host_raw_equal",
        "swift_extension_raw_equal",
        "swift_host_uuid_present_both",
        "swift_extension_uuid_present_both",
        "swift_host_uuid_equal",
        "swift_extension_uuid_equal",
        "app_regular_file_inventory_equal"
      ],
      "properties": {
        "rust_sha256_equal": {
          "type": "boolean"
        },
        "swift_tree_equal": {
          "type": "boolean"
        },
        "ordered_tree_equal": {
          "type": "boolean"
        },
        "swift_objects_equal": {
          "type": "boolean"
        },
        "swift_modules_equal": {
          "type": "boolean"
        },
        "endpoint_security_linked_both": {
          "type": "boolean"
        },
        "swift_host_raw_equal": {
          "type": "boolean"
        },
        "swift_extension_raw_equal": {
          "type": "boolean"
        },
        "swift_host_uuid_present_both": {
          "type": "boolean"
        },
        "swift_extension_uuid_present_both": {
          "type": "boolean"
        },
        "swift_host_uuid_equal": {
          "type": "boolean"
        },
        "swift_extension_uuid_equal": {
          "type": "boolean"
        },
        "app_regular_file_inventory_equal": {
          "type": "boolean"
        }
      }
    },
    "divergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layers",
        "first_divergence_layer",
        "candidate_next_control"
      ],
      "properties": {
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module_cache",
            "swift_objects",
            "swift_modules",
            "linked_products",
            "app"
          ],
          "properties": {
            "module_cache": {
              "$ref": "#/$defs/layer_comparison"
            },
            "swift_objects": {
              "$ref": "#/$defs/layer_comparison"
            },
            "swift_modules": {
              "$ref": "#/$defs/layer_comparison"
            },
            "linked_products": {
              "$ref": "#/$defs/layer_comparison"
            },
            "app": {
              "$ref": "#/$defs/layer_comparison"
            }
          }
        },
        "first_divergence_layer": {
          "enum": [
            "module_cache",
            "swift_objects",
            "swift_modules",
            "linked_products",
            "app",
            null
          ]
        },
        "candidate_next_control": {
          "enum": [
            "swift_module_cache_context_inputs",
            "swift_compiler_determinism",
            "swift_module_serialization",
            "swift_link_reproducibility",
            "package_copy_contract",
            "none"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "first_divergence_layer": {
              "const": "module_cache"
            },
            "candidate_next_control": {
              "const": "swift_module_cache_context_inputs"
            },
            "layers": {
              "properties": {
                "module_cache": {
                  "$ref": "#/$defs/layer_divergent"
                }
              }
            }
          }
        },
        {
          "properties": {
            "first_divergence_layer": {
              "const": "swift_objects"
            },
            "candidate_next_control": {
              "const": "swift_compiler_determinism"
            },
            "layers": {
              "properties": {
                "module_cache": {
                  "$ref": "#/$defs/layer_equal"
                },
                "swift_objects": {
                  "$ref": "#/$defs/layer_divergent"
                }
              }
            }
          }
        },
        {
          "properties": {
            "first_divergence_layer": {
              "const": "swift_modules"
            },
            "candidate_next_control": {
              "const": "swift_module_serialization"
            },
            "layers": {
              "properties": {
                "module_cache": {
                  "$ref": "#/$defs/layer_equal"
                },
                "swift_objects": {
                  "$ref": "#/$defs/layer_equal"
                },
                "swift_modules": {
                  "$ref": "#/$defs/layer_divergent"
                }
              }
            }
          }
        },
        {
          "properties": {
            "first_divergence_layer": {
              "const": "linked_products"
            },
            "candidate_next_control": {
              "const": "swift_link_reproducibility"
            },
            "layers": {
              "properties": {
                "module_cache": {
                  "$ref": "#/$defs/layer_equal"
                },
                "swift_objects": {
                  "$ref": "#/$defs/layer_equal"
                },
                "swift_modules": {
                  "$ref": "#/$defs/layer_equal"
                },
                "linked_products": {
                  "$ref": "#/$defs/layer_divergent"
                }
              }
            }
          }
        },
        {
          "properties": {
            "first_divergence_layer": {
              "const": "app"
            },
            "candidate_next_control": {
              "const": "package_copy_contract"
            },
            "layers": {
              "properties": {
                "module_cache": {
                  "$ref": "#/$defs/layer_equal"
                },
                "swift_objects": {
                  "$ref": "#/$defs/layer_equal"
                },
                "swift_modules": {
                  "$ref": "#/$defs/layer_equal"
                },
                "linked_products": {
                  "$ref": "#/$defs/layer_equal"
                },
                "app": {
                  "$ref": "#/$defs/layer_divergent"
                }
              }
            }
          }
        },
        {
          "properties": {
            "first_divergence_layer": {
              "const": null
            },
            "candidate_next_control": {
              "const": "none"
            },
            "layers": {
              "properties": {
                "module_cache": {
                  "$ref": "#/$defs/layer_equal"
                },
                "swift_objects": {
                  "$ref": "#/$defs/layer_equal"
                },
                "swift_modules": {
                  "$ref": "#/$defs/layer_equal"
                },
                "linked_products": {
                  "$ref": "#/$defs/layer_equal"
                },
                "app": {
                  "$ref": "#/$defs/layer_equal"
                }
              }
            }
          }
        }
      ]
    },
    "negative_control": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "endpoint_security_linked",
        "classified_blocked_stub"
      ],
      "properties": {
        "id": {
          "const": "negative-control"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "endpoint_security_linked": {
          "type": "boolean"
        },
        "classified_blocked_stub": {
          "type": "boolean"
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apple_trust_proven",
        "signed",
        "notarized",
        "installed",
        "activated",
        "full_disk_access",
        "backend_connected",
        "production_ready"
      ],
      "properties": {
        "apple_trust_proven": {
          "const": false
        },
        "signed": {
          "const": false
        },
        "notarized": {
          "const": false
        },
        "installed": {
          "const": false
        },
        "activated": {
          "const": false
        },
        "full_disk_access": {
          "const": false
        },
        "backend_connected": {
          "const": false
        },
        "production_ready": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "module_cache_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "compiler_visible_path_equal",
        "prebuild_empty_a",
        "prebuild_empty_b",
        "removed_between",
        "postrun_removed",
        "run_local_exclusive_lease",
        "module_cache_reused"
      ],
      "properties": {
        "execution": {
          "const": "sequential"
        },
        "compiler_visible_path_equal": {
          "const": true
        },
        "prebuild_empty_a": {
          "const": true
        },
        "prebuild_empty_b": {
          "const": true
        },
        "removed_between": {
          "const": true
        },
        "postrun_removed": {
          "const": true
        },
        "run_local_exclusive_lease": {
          "const": true
        },
        "module_cache_reused": {
          "const": false
        }
      }
    },
    "swift_scratch_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "compiler_visible_path_equal",
        "prebuild_empty_a",
        "prebuild_empty_b",
        "removed_between",
        "postrun_removed",
        "run_local_exclusive_lease",
        "scratch_reused"
      ],
      "properties": {
        "execution": {
          "const": "sequential"
        },
        "compiler_visible_path_equal": {
          "const": true
        },
        "prebuild_empty_a": {
          "const": true
        },
        "prebuild_empty_b": {
          "const": true
        },
        "removed_between": {
          "const": true
        },
        "postrun_removed": {
          "const": true
        },
        "run_local_exclusive_lease": {
          "const": true
        },
        "scratch_reused": {
          "const": false
        }
      }
    },
    "layer_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_set_equal",
        "shared_entries_equal",
        "only_a_count",
        "only_b_count",
        "same_path_mismatch_count"
      ],
      "properties": {
        "path_set_equal": {
          "type": "boolean"
        },
        "shared_entries_equal": {
          "type": "boolean"
        },
        "only_a_count": {
          "type": "integer",
          "minimum": 0
        },
        "only_b_count": {
          "type": "integer",
          "minimum": 0
        },
        "same_path_mismatch_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "path_set_equal": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "only_a_count": {
                "const": 0
              },
              "only_b_count": {
                "const": 0
              }
            }
          },
          "else": {
            "anyOf": [
              {
                "properties": {
                  "only_a_count": {
                    "minimum": 1
                  }
                }
              },
              {
                "properties": {
                  "only_b_count": {
                    "minimum": 1
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "shared_entries_equal": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "same_path_mismatch_count": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "same_path_mismatch_count": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "layer_equal": {
      "allOf": [
        {
          "$ref": "#/$defs/layer_comparison"
        },
        {
          "properties": {
            "path_set_equal": {
              "const": true
            },
            "shared_entries_equal": {
              "const": true
            }
          }
        }
      ]
    },
    "layer_divergent": {
      "allOf": [
        {
          "$ref": "#/$defs/layer_comparison"
        },
        {
          "anyOf": [
            {
              "properties": {
                "path_set_equal": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "shared_entries_equal": {
                  "const": false
                }
              }
            }
          ]
        }
      ]
    },
    "presence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "mode",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "regular_file_count",
        "regular_file_inventory"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^package-[ab]/TamanduaAgent\\.app$"
        },
        "regular_file_count": {
          "type": "integer",
          "minimum": 1
        },
        "regular_file_inventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "swift_products": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "extension",
        "host_uuid_present",
        "extension_uuid_present"
      ],
      "properties": {
        "host": {
          "$ref": "#/$defs/file"
        },
        "extension": {
          "$ref": "#/$defs/file"
        },
        "host_uuid_present": {
          "type": "boolean"
        },
        "extension_uuid_present": {
          "type": "boolean"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rust",
        "swift_tree",
        "swift_objects",
        "swift_modules",
        "swift_products",
        "ordered_tree",
        "endpoint_security_linked",
        "package"
      ],
      "properties": {
        "id": {
          "enum": [
            "a",
            "b"
          ]
        },
        "rust": {
          "$ref": "#/$defs/file"
        },
        "swift_tree": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "swift_objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "swift_modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "swift_products": {
          "$ref": "#/$defs/swift_products"
        },
        "ordered_tree": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "endpoint_security_linked": {
          "type": "boolean"
        },
        "package": {
          "$ref": "#/$defs/package"
        }
      }
    }
  }
}
