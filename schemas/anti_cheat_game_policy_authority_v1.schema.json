{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tamandua.local/anti_cheat_game_policy_authority_v1.schema.json",
  "title": "Tamandua synthetic offline signed game-policy authority v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidence_class", "game_003a_policy_digest", "expected_scope", "trust_root", "revocations", "prior_checkpoint", "signed_envelope", "signature_hex", "claims"],
  "properties": {
    "schema": {"const": "tamandua.anti_cheat.game_policy_authority/v1"},
    "evidence_class": {"const": "synthetic_offline_contract"},
    "game_003a_policy_digest": {"$ref": "#/$defs/digest"},
    "expected_scope": {"$ref": "#/$defs/scope"},
    "trust_root": {
      "type": "object", "additionalProperties": false,
      "required": ["root_id", "algorithm", "keys"],
      "properties": {
        "root_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"},
        "algorithm": {"const": "Ed25519"},
        "keys": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/key"}}
      }
    },
    "revocations": {
      "type": "object", "additionalProperties": false, "required": ["version", "revoked_key_ids"],
      "properties": {"version": {"type": "integer", "minimum": 0}, "revoked_key_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/keyId"}}}
    },
    "prior_checkpoint": {"$ref": "#/$defs/checkpoint"},
    "signed_envelope": {"$ref": "#/$defs/envelope"},
    "signature_hex": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "claims": {"$ref": "#/$defs/falseClaims"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "keyId": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"},
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["tenant_scope_digest", "game_id", "build_digest"],
      "properties": {"tenant_scope_digest": {"$ref": "#/$defs/digest"}, "game_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"}, "build_digest": {"$ref": "#/$defs/digest"}}
    },
    "key": {
      "type": "object", "additionalProperties": false, "required": ["key_id", "public_key_hex", "authorized_epochs"],
      "properties": {"key_id": {"$ref": "#/$defs/keyId"}, "public_key_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "authorized_epochs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}}
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_epoch", "revision", "revocation_version", "revocation_set_digest", "revoked_key_ids", "policy_digest", "envelope_digest", "checkpoint_digest"],
      "properties": {"authority_epoch": {"type": "integer", "minimum": 1}, "revision": {"type": "integer", "minimum": 1}, "revocation_version": {"type": "integer", "minimum": 0}, "revocation_set_digest": {"$ref": "#/$defs/digest"}, "revoked_key_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/keyId"}}, "policy_digest": {"$ref": "#/$defs/digest"}, "envelope_digest": {"$ref": "#/$defs/digest"}, "checkpoint_digest": {"$ref": "#/$defs/digest"}}
    },
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "scope", "policy", "mapping", "authority", "validity", "revocation_version", "revocation_digest", "prior_checkpoint_digest"],
      "properties": {
        "schema": {"const": "tamandua.anti_cheat.signed_game_policy_envelope/v1"},
        "scope": {"$ref": "#/$defs/scope"},
        "policy": {"type": "object", "additionalProperties": false, "required": ["policy_id", "policy_version", "policy_digest"], "properties": {"policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"}, "policy_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$"}, "policy_digest": {"$ref": "#/$defs/digest"}}},
        "mapping": {"type": "object", "additionalProperties": false, "required": ["features", "detectors"], "properties": {"features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "detectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
        "authority": {"type": "object", "additionalProperties": false, "required": ["key_id", "authority_epoch", "revision"], "properties": {"key_id": {"$ref": "#/$defs/keyId"}, "authority_epoch": {"type": "integer", "minimum": 1}, "revision": {"type": "integer", "minimum": 1}}},
        "validity": {"type": "object", "additionalProperties": false, "required": ["issued_at_unix", "not_before_unix", "expires_at_unix"], "properties": {"issued_at_unix": {"type": "integer", "minimum": 0}, "not_before_unix": {"type": "integer", "minimum": 0}, "expires_at_unix": {"type": "integer", "minimum": 0}}},
        "revocation_version": {"type": "integer", "minimum": 0},
        "revocation_digest": {"$ref": "#/$defs/digest"},
        "prior_checkpoint_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "falseClaims": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_authorized", "enforcement_authorized", "external_latest_state_validated", "rollback_durability_validated", "production_ready", "external_claim_allowed"],
      "properties": {"runtime_authorized": {"const": false}, "enforcement_authorized": {"const": false}, "external_latest_state_validated": {"const": false}, "rollback_durability_validated": {"const": false}, "production_ready": {"const": false}, "external_claim_allowed": {"const": false}}
    }
  }
}
