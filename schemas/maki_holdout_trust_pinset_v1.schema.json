{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/maki_holdout_trust_pinset_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "bundle_id", "epoch", "valid_from", "valid_until", "authorities", "claims"],
  "properties": {
    "schema": {"const": "tamandua.maki.holdout-trust-pinset/v1"},
    "profile": {"const": "disabled"},
    "bundle_id": {"$ref": "#/$defs/id"},
    "epoch": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "valid_from": {"$ref": "#/$defs/time"},
    "valid_until": {"$ref": "#/$defs/time"},
    "authorities": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/authority"},
      "allOf": [
        {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "candidate_issuer"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "executor_completion"}}}, "minContains": 1, "maxContains": 1}
      ]
    },
    "claims": {"$ref": "#/$defs/falseOutputs"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "format": "date-time"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "domain", "key_id", "algorithm", "key_epoch", "status", "valid_from", "valid_until", "public_key_b64", "public_key_sha256", "trust_root_sha256"],
      "properties": {
        "role": {"enum": ["candidate_issuer", "executor_completion"]},
        "domain": {"enum": ["tamandua.maki.holdout-live-execution-authorization-candidate.ed25519/v1", "tamandua.maki.holdout-operation-completion.ed25519/v1"]},
        "key_id": {"$ref": "#/$defs/id"},
        "algorithm": {"const": "Ed25519"},
        "key_epoch": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "status": {"const": "revoked"},
        "valid_from": {"$ref": "#/$defs/time"},
        "valid_until": {"$ref": "#/$defs/time"},
        "public_key_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
        "public_key_sha256": {"$ref": "#/$defs/sha256"},
        "trust_root_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {"if": {"required": ["role"], "properties": {"role": {"const": "candidate_issuer"}}}, "then": {"properties": {"domain": {"const": "tamandua.maki.holdout-live-execution-authorization-candidate.ed25519/v1"}}}},
        {"if": {"required": ["role"], "properties": {"role": {"const": "executor_completion"}}}, "then": {"properties": {"domain": {"const": "tamandua.maki.holdout-operation-completion.ed25519/v1"}}}}
      ]
    },
    "falseOutputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust_pins_compiled", "enabled_module_emitted", "coordinator_enabled", "live_execution_authorized", "aws_credentials_resolved", "aws_mutation_performed", "membership_granted", "evaluation_allowed", "training_allowed"],
      "properties": {
        "trust_pins_compiled": {"const": false},
        "enabled_module_emitted": {"const": false},
        "coordinator_enabled": {"const": false},
        "live_execution_authorized": {"const": false},
        "aws_credentials_resolved": {"const": false},
        "aws_mutation_performed": {"const": false},
        "membership_granted": {"const": false},
        "evaluation_allowed": {"const": false},
        "training_allowed": {"const": false}
      }
    }
  }
}
