{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/security_interop_registry_v1.schema.json",
  "title": "Tamandua security interoperability schema registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "status", "owner", "entries"],
  "properties": {
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "active", "deprecated"]},
    "owner": {"type": "string", "minLength": 3},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "family", "schema_version", "revision", "source_url",
        "status", "mapping_lifecycle", "mapping_ref", "loss_ledger_ref",
        "compatibility_policy", "owner", "evidence_class", "conformance_claim",
        "depends_on"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
        "family": {"enum": ["tamandua", "ocsf", "ecs", "udm", "asim"]},
        "schema_version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "pattern": "^https://"},
        "status": {"enum": ["planned", "active", "deprecated"]},
        "mapping_lifecycle": {
          "enum": ["planned", "draft", "mapped", "validated", "deprecated"]
        },
        "mapping_ref": {"type": "string", "minLength": 1},
        "loss_ledger_ref": {"type": "string", "minLength": 1},
        "compatibility_policy": {
          "enum": ["exact_only", "backward_minor", "forward_additive"]
        },
        "owner": {"type": "string", "minLength": 3},
        "evidence_class": {
          "enum": [
            "none", "smoke", "synthetic_parity", "bootstrap_calibration",
            "governed_holdout", "production_telemetry"
          ]
        },
        "conformance_claim": {"type": "boolean"},
        "depends_on": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
