{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/agent_uninstall_breakglass_v1.schema.json",
  "title": "Tamandua agent uninstall offline break-glass envelope v1",
  "$comment": "Raw UTF-8 byte bounds, member order, duplicate rejection, decoded payload canonicalization, time relationships, and Ed25519 verification are enforced by the companion contract guard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "$ref": "#/$defs/base64urlNoPad"
    },
    "signature": {
      "allOf": [
        {
          "$ref": "#/$defs/base64urlNoPad"
        },
        {
          "minLength": 86,
          "maxLength": 86
        }
      ]
    }
  },
  "$defs": {
    "base64urlNoPad": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "canonicalUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utcWholeSecond": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "agent_id",
        "authorization_mode",
        "consumer",
        "expires_at",
        "intent_id",
        "issued_at",
        "issued_by_user_id",
        "key_domain",
        "key_id",
        "nonce",
        "not_before",
        "organization_id",
        "platform",
        "reason",
        "schema_version"
      ],
      "properties": {
        "action": {
          "const": "agent_uninstall"
        },
        "agent_id": {
          "$ref": "#/$defs/canonicalUuid"
        },
        "authorization_mode": {
          "const": "offline_breakglass"
        },
        "consumer": {
          "enum": ["native_cli", "windows_msi"]
        },
        "expires_at": {
          "$ref": "#/$defs/utcWholeSecond"
        },
        "intent_id": {
          "$ref": "#/$defs/canonicalUuid"
        },
        "issued_at": {
          "$ref": "#/$defs/utcWholeSecond"
        },
        "issued_by_user_id": {
          "$ref": "#/$defs/canonicalUuid"
        },
        "key_domain": {
          "const": "tamandua.uninstall-breakglass.ed25519/v1"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "nonce": {
          "allOf": [
            {
              "$ref": "#/$defs/base64urlNoPad"
            },
            {
              "minLength": 43,
              "maxLength": 43
            }
          ]
        },
        "not_before": {
          "$ref": "#/$defs/utcWholeSecond"
        },
        "organization_id": {
          "$ref": "#/$defs/canonicalUuid"
        },
        "platform": {
          "enum": ["windows", "linux", "macos"]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "schema_version": {
          "const": "tamandua.uninstall-breakglass/v1"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["consumer"],
            "properties": {
              "consumer": {
                "const": "windows_msi"
              }
            }
          },
          "then": {
            "properties": {
              "platform": {
                "const": "windows"
              }
            }
          }
        }
      ]
    }
  }
}
