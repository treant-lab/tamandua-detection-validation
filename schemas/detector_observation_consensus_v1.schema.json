{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.io/schemas/detector_observation_consensus_v1.schema.json",
  "title": "Tamandua Detector Observation and Consensus v1",
  "description": "Model-agnostic integration contract. Validation proves payload compatibility only, not detector efficacy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "artifact",
    "input_contract",
    "observations",
    "consensus",
    "validation_context"
  ],
  "properties": {
    "api_version": {
      "const": "tamandua.io/detector-observation-consensus/v1"
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "input_contract": {
      "$ref": "#/$defs/inputContract"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "consensus": {
      "$ref": "#/$defs/consensus"
    },
    "validation_context": {
      "$ref": "#/$defs/validationContext"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "observations": {
            "contains": {
              "type": "object",
              "required": ["status", "runtime_lane", "decision_mode"],
              "properties": {
                "status": {"const": "completed"},
                "runtime_lane": {"const": "endpoint_shadow"},
                "decision_mode": {"const": "detect_only"}
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "consensus": {
            "properties": {
              "score": {"type": "null"},
              "threshold": {"type": "null"},
              "decision": {"const": "unknown"},
              "confidence": {"const": 0},
              "degraded": {"const": true}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "enum": ["malicious", "suspicious", "benign", "unknown"]
    },
    "runtimeLane": {
      "enum": ["embedded_onnx", "embedded_treelite", "local_service", "endpoint_shadow", "backend", "decision_only", "none"]
    },
    "decisionMode": {
      "enum": ["detect_only", "decision_only", "enforced", "failed_enforcement"]
    },
    "ensembleVote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detector_id", "status", "score", "decision", "confidence"],
      "properties": {
        "detector_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "status": {"enum": ["completed", "cached", "degraded", "timeout", "failed", "unsupported"]},
        "score": {"type": ["number", "null"]},
        "decision": {"$ref": "#/$defs/decision"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["completed", "cached"]}}},
          "then": {"properties": {"score": {"type": "number"}, "decision": {"enum": ["malicious", "suspicious", "benign"]}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["degraded", "timeout", "failed", "unsupported"]}}},
          "then": {"properties": {"score": {"type": "null"}, "decision": {"const": "unknown"}, "confidence": {"const": 0}}}
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "media_type"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "inputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "contract_version", "schema_sha256"],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "contract_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "feature_set": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "revision", "artifact_sha256"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detector_id",
        "detector_type",
        "detector_version",
        "score",
        "score_orientation",
        "threshold",
        "decision",
        "confidence",
        "latency_ms",
        "status",
        "degraded",
        "error",
        "provenance",
        "observed_at"
      ],
      "properties": {
        "detector_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "detector_type": {
          "enum": ["model", "rule", "heuristic", "reputation", "sandbox", "human", "ensemble", "other"]
        },
        "detector_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "score": {
          "type": ["number", "null"]
        },
        "score_orientation": {
          "enum": ["higher_is_more_malicious", "lower_is_more_malicious", "categorical"]
        },
        "threshold": {
          "type": ["number", "null"]
        },
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "enum": ["completed", "cached", "degraded", "timeout", "failed", "unsupported"]
        },
        "degraded": {
          "type": "boolean"
        },
        "error": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/error"}
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "runtime_lane": {
          "$ref": "#/$defs/runtimeLane"
        },
        "model_contract_id": {
          "type": ["string", "null"],
          "minLength": 3,
          "maxLength": 256
        },
        "decision_mode": {
          "$ref": "#/$defs/decisionMode"
        },
        "ensemble_votes": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/ensembleVote"}
        }
      },
      "allOf": [
        {
          "if": {
            "allOf": [
              {"properties": {"status": {"enum": ["completed", "cached"]}}},
              {
                "not": {
                  "required": ["status", "runtime_lane", "decision_mode"],
                  "properties": {
                    "status": {"const": "completed"},
                    "runtime_lane": {"const": "endpoint_shadow"},
                    "decision_mode": {"const": "detect_only"}
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "score": {"type": "number"},
              "threshold": {"type": "number"},
              "decision": {"enum": ["malicious", "suspicious", "benign"]},
              "degraded": {"const": false},
              "error": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "required": ["status", "runtime_lane", "decision_mode"],
            "properties": {
              "status": {"const": "completed"},
              "runtime_lane": {"const": "endpoint_shadow"},
              "decision_mode": {"const": "detect_only"}
            }
          },
          "then": {
            "properties": {
              "score": {"type": "number"},
              "threshold": {"type": "number"},
              "decision": {"const": "unknown"},
              "confidence": {"const": 0},
              "degraded": {"const": false},
              "error": {"type": "null"},
              "ensemble_votes": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"enum": ["degraded", "timeout", "failed", "unsupported"]}
            }
          },
          "then": {
            "properties": {
              "score": {"type": "null"},
              "threshold": {"type": "null"},
              "decision": {"const": "unknown"},
              "confidence": {"const": 0},
              "degraded": {"const": true},
              "error": {"$ref": "#/$defs/error"}
            }
          }
        }
      ]
    },
    "consensus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "strategy_version",
        "member_detector_ids",
        "score",
        "score_orientation",
        "threshold",
        "decision",
        "confidence",
        "degraded",
        "error",
        "generated_at"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "strategy_version": {
          "type": "string",
          "minLength": 1
        },
        "member_detector_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "score": {
          "type": ["number", "null"]
        },
        "score_orientation": {
          "enum": ["higher_is_more_malicious", "lower_is_more_malicious", "categorical"]
        },
        "threshold": {
          "type": ["number", "null"]
        },
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "degraded": {
          "type": "boolean"
        },
        "error": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/error"}
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"degraded": {"const": false}}
          },
          "then": {
            "properties": {
              "score": {"type": "number"},
              "threshold": {"type": "number"},
              "decision": {"enum": ["malicious", "suspicious", "benign"]},
              "error": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"degraded": {"const": true}}
          },
          "then": {
            "properties": {
              "score": {"type": "null"},
              "threshold": {"type": "null"},
              "decision": {"const": "unknown"},
              "confidence": {"const": 0},
              "error": {"$ref": "#/$defs/error"}
            }
          }
        }
      ]
    },
    "validationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_class", "claim_scope", "effectiveness_metrics"],
      "properties": {
        "evidence_class": {
          "enum": ["contract_smoke", "synthetic_parity", "bootstrap_calibration", "governed_holdout", "production_telemetry"]
        },
        "claim_scope": {
          "enum": ["contract_only", "parity_only", "calibration_only", "efficacy"]
        },
        "effectiveness_metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"evidence_class": {"const": "contract_smoke"}}
          },
          "then": {
            "properties": {
              "claim_scope": {"const": "contract_only"},
              "effectiveness_metrics": {"maxItems": 0}
            }
          }
        }
      ]
    }
  }
}
