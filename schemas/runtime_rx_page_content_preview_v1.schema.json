{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/runtime_rx_page_content_preview_v1.schema.json",
  "title": "Tamandua Linux self-image RX page-content Preview evidence v1",
  "$comment": "Synthetic/local model contract for the Linux-only tamandua.runtime_integrity/v2 extension. The fixture does not execute or prove protected-config or startup-FD behavior and is not production, efficacy, performance, FPR, or vendor-parity evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provenance",
    "platform",
    "state",
    "findings",
    "limitations",
    "page_content"
  ],
  "properties": {
    "schema": {
      "const": "tamandua.runtime_integrity/v2"
    },
    "provenance": {
      "const": "platform_collector"
    },
    "platform": {
      "const": "linux"
    },
    "state": {
      "enum": ["supported", "degraded", "unsupported"]
    },
    "findings": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/legacyFinding"
          },
          {
            "$ref": "#/$defs/pageDriftFinding"
          }
        ]
      },
      "contains": {
        "$ref": "#/$defs/pageDriftFinding"
      },
      "minContains": 0,
      "maxContains": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
      }
    },
    "page_content": {
      "$ref": "#/$defs/pageContent"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "page_content": {
            "required": ["status"],
            "properties": {
              "status": {
                "const": "mismatch"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "$ref": "#/$defs/pageDriftFinding"
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      },
      "else": {
        "properties": {
          "findings": {
            "not": {
              "contains": {
                "$ref": "#/$defs/pageDriftFinding"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "page_content": {
            "required": ["status"],
            "properties": {
              "status": {
                "const": "disabled"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "limitations": {
            "contains": {
              "const": "rx_page_content_disabled"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "page_content": {
            "required": ["status"],
            "properties": {
              "status": {
                "const": "degraded"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "degraded"
          },
          "limitations": {
            "contains": {
              "enum": [
                "rx_page_content_baseline_unavailable",
                "rx_page_content_baseline_mismatch",
                "rx_page_content_backing_deleted",
                "rx_page_content_backing_replaced",
                "rx_page_content_identity_race",
                "rx_page_content_execute_only",
                "rx_page_content_elf_unsupported",
                "rx_page_content_relocation_unsupported",
                "rx_page_content_budget_exceeded",
                "rx_page_content_no_eligible_pages",
                "rx_page_content_memory_read_unavailable"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "page_content": {
            "required": ["status"],
            "properties": {
              "status": {
                "const": "unsupported"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "degraded"
          },
          "limitations": {
            "contains": {
              "const": "rx_page_content_elf_unsupported"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "page_content": {
            "required": ["budget_state"],
            "properties": {
              "budget_state": {
                "const": "exceeded"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "page_content": {
            "properties": {
              "status": {
                "const": "degraded"
              },
              "elapsed_us": {
                "minimum": 10001
              }
            }
          },
          "limitations": {
            "contains": {
              "const": "rx_page_content_budget_exceeded"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "limitations": {
            "contains": {
              "const": "rx_page_content_budget_exceeded"
            }
          }
        }
      },
      "then": {
        "properties": {
          "page_content": {
            "properties": {
              "status": {
                "const": "degraded"
              },
              "budget_state": {
                "const": "exceeded"
              },
              "elapsed_us": {
                "minimum": 10001
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "page_content": {
            "required": ["elapsed_us"],
            "properties": {
              "elapsed_us": {
                "minimum": 10001
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "page_content": {
            "properties": {
              "status": {
                "const": "degraded"
              },
              "budget_state": {
                "const": "exceeded"
              }
            }
          },
          "limitations": {
            "contains": {
              "const": "rx_page_content_budget_exceeded"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "legacyFinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "evidence"],
          "properties": {
            "kind": {
              "const": "writable_executable_mapping"
            },
            "evidence": {
              "const": "current process exposed a writable executable mapping"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "evidence"],
          "properties": {
            "kind": {
              "const": "debugger_or_tracer_attached"
            },
            "evidence": {
              "const": "current process reported a debugger or tracer attached"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "evidence"],
          "properties": {
            "kind": {
              "const": "instrumentation_library_loaded"
            },
            "evidence": {
              "const": "current process loaded a known instrumentation library marker"
            }
          }
        }
      ]
    },
    "pageDriftFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "evidence"],
      "properties": {
        "kind": {
          "const": "file_backed_executable_page_drift"
        },
        "evidence": {
          "const": "file-backed executable page content differed from the protected startup baseline"
        }
      }
    },
    "pageContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "maturity",
        "mode",
        "enabled",
        "status",
        "baseline_source",
        "eligible_pages",
        "compared_pages",
        "excluded_relocation_pages",
        "unstable_pages",
        "bytes_read",
        "elapsed_us",
        "budget_limit_us",
        "full_sweep_completed",
        "budget_state"
      ],
      "properties": {
        "capability_id": {
          "const": "linux_self_file_backed_elf_rx_page_content_preview_v1"
        },
        "maturity": {
          "const": "preview"
        },
        "mode": {
          "const": "observe_only"
        },
        "enabled": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "disabled",
            "partial",
            "clean",
            "mismatch",
            "degraded",
            "unsupported"
          ]
        },
        "baseline_source": {
          "enum": ["none", "protected_config_sha256_startup_fd"]
        },
        "eligible_pages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "compared_pages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "excluded_relocation_pages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "unstable_pages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "bytes_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "elapsed_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "budget_limit_us": {
          "const": 10000
        },
        "full_sweep_completed": {
          "type": "boolean"
        },
        "budget_state": {
          "enum": ["within_budget", "exceeded"]
        }
      },
      "oneOf": [
        {
          "properties": {
            "enabled": {
              "const": false
            },
            "status": {
              "const": "disabled"
            },
            "baseline_source": {
              "const": "none"
            },
            "eligible_pages": {
              "const": 0
            },
            "compared_pages": {
              "const": 0
            },
            "excluded_relocation_pages": {
              "const": 0
            },
            "unstable_pages": {
              "const": 0
            },
            "bytes_read": {
              "const": 0
            },
            "elapsed_us": {
              "const": 0
            },
            "full_sweep_completed": {
              "const": false
            },
            "budget_state": {
              "const": "within_budget"
            }
          }
        },
        {
          "properties": {
            "enabled": {
              "const": true
            },
            "status": {
              "const": "partial"
            },
            "baseline_source": {
              "const": "protected_config_sha256_startup_fd"
            },
            "eligible_pages": {
              "minimum": 1
            },
            "compared_pages": {
              "minimum": 1
            },
            "elapsed_us": {
              "maximum": 10000
            },
            "full_sweep_completed": {
              "const": false
            },
            "budget_state": {
              "const": "within_budget"
            }
          }
        },
        {
          "properties": {
            "enabled": {
              "const": true
            },
            "status": {
              "const": "clean"
            },
            "baseline_source": {
              "const": "protected_config_sha256_startup_fd"
            },
            "eligible_pages": {
              "minimum": 1
            },
            "compared_pages": {
              "minimum": 1
            },
            "elapsed_us": {
              "maximum": 10000
            },
            "full_sweep_completed": {
              "const": true
            },
            "budget_state": {
              "const": "within_budget"
            }
          }
        },
        {
          "properties": {
            "enabled": {
              "const": true
            },
            "status": {
              "const": "mismatch"
            },
            "baseline_source": {
              "const": "protected_config_sha256_startup_fd"
            },
            "compared_pages": {
              "minimum": 1
            },
            "elapsed_us": {
              "maximum": 10000
            },
            "budget_state": {
              "const": "within_budget"
            }
          }
        },
        {
          "properties": {
            "enabled": {
              "const": true
            },
            "status": {
              "const": "degraded"
            },
            "full_sweep_completed": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "enabled": {
              "const": true
            },
            "status": {
              "const": "unsupported"
            },
            "eligible_pages": {
              "const": 0
            },
            "compared_pages": {
              "const": 0
            },
            "excluded_relocation_pages": {
              "const": 0
            },
            "unstable_pages": {
              "const": 0
            },
            "bytes_read": {
              "const": 0
            },
            "elapsed_us": {
              "maximum": 10000
            },
            "full_sweep_completed": {
              "const": false
            },
            "budget_state": {
              "const": "within_budget"
            }
          }
        }
      ]
    }
  }
}
