{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/runtime_rx_page_content_live_probe_diagnostic_v1.schema.json",
  "title": "Tamandua runtime RX page-content live-probe diagnostic v1",
  "$comment": "Privacy-safe failure diagnostic only. It is not efficacy, FPR, performance, production-readiness, or vendor-parity evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "evidence_class", "execution_scope", "execute", "diagnostic_provenance",
    "external_claim_allowed", "fpr_claim_allowed", "performance_claim_allowed",
    "production_ready_claimed", "vendor_parity_claimed", "run_id", "observed_at_utc",
    "prior_failure_manifest_sha256", "checkpoint", "code", "process", "output",
    "trace", "custody", "cleanup"
  ],
  "properties": {
    "schema": {"const": "tamandua.runtime_integrity_live_probe_diagnostic/v1"},
    "evidence_class": {"const": "local_live_probe_failure_diagnostic"},
    "execution_scope": {"const": "wsl2_network_isolated"},
    "execute": {"type": "boolean"},
    "diagnostic_provenance": {"enum": ["synthetic_fixture", "live_probe_runner"]},
    "external_claim_allowed": {"const": false},
    "fpr_claim_allowed": {"const": false},
    "performance_claim_allowed": {"const": false},
    "production_ready_claimed": {"const": false},
    "vendor_parity_claimed": {"const": false},
    "run_id": {
      "oneOf": [
        {"enum": ["synthetic-internal-probe-timeout", "synthetic-runner-trace-policy"]},
        {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-runtime-rx-live-[0-9a-f]{24}$"}
      ]
    },
    "observed_at_utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
    "prior_failure_manifest_sha256": {"const": "70f0b15c6387946134946c86be6ddc557a148ba5cf2b98d952eba1469ebca5df"},
    "checkpoint": {"enum": ["probe_execute", "runner_trace_policy", "custody_validate", "cleanup"]},
    "code": {"enum": [
      "probe_timeout", "process_exit_nonzero", "output_absent", "output_empty",
      "output_invalid", "output_oversize", "trace_network_syscall_observed",
      "trace_filesystem_mutation_observed", "trace_incomplete", "artifact_changed",
      "config_changed", "cleanup_incomplete"
    ]},
    "process": {"$ref": "#/$defs/process"},
    "output": {"$ref": "#/$defs/output"},
    "trace": {"$ref": "#/$defs/trace"},
    "custody": {"$ref": "#/$defs/custody"},
    "cleanup": {"$ref": "#/$defs/cleanup"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "process": {
      "type": "object", "additionalProperties": false,
      "required": ["started", "exit_observed", "exit_code", "timed_out"],
      "properties": {
        "started": {"const": true},
        "exit_observed": {"type": "boolean"},
        "exit_code": {"type": ["integer", "null"], "minimum": -255, "maximum": 255},
        "timed_out": {"type": "boolean"}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "bytes", "sha256"],
      "properties": {
        "state": {"enum": ["absent", "empty", "partial", "complete_invalid", "complete_valid"]},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "network_syscall_count", "filesystem_mutation_syscall_count", "strace_sha256", "time_sha256"],
      "properties": {
        "state": {"enum": ["complete", "partial", "unavailable"]},
        "network_syscall_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "filesystem_mutation_syscall_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "strace_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "time_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "custody": {
      "type": "object", "additionalProperties": false,
      "$comment": "These booleans are bounded failure-diagnostic custody observations, not provenance or release attestations.",
      "required": ["artifact_unchanged", "config_unchanged"],
      "properties": {
        "artifact_unchanged": {"type": "boolean", "description": "Bounded diagnostic observation only."},
        "config_unchanged": {"type": "boolean", "description": "Bounded diagnostic observation only."}
      }
    },
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["attempted", "completed", "temporary_artifacts_remaining", "raw_logs_retained"],
      "properties": {
        "attempted": {"const": true},
        "completed": {"type": "boolean"},
        "temporary_artifacts_remaining": {"type": "integer", "minimum": 0, "maximum": 1024},
        "raw_logs_retained": {"const": false}
      }
    }
  }
}
