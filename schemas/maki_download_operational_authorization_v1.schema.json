{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.io/schemas/maki_download_operational_authorization_v1.schema.json",
  "type": "object",
  "required": ["api_version", "authorization_id", "authority", "approval_id", "issued_at", "expires_at", "nonce", "download_allowed", "plan_sha256", "source_dry_run_plan", "allowed_buckets", "maximum_total_bytes", "one_time_use", "authorization_sha256"],
  "properties": {
    "api_version": {"const": "tamandua.io/maki-download-operational-authorization/v1"},
    "authorization_id": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "approval_id": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 16},
    "download_allowed": {"const": true},
    "plan_sha256": {"$ref": "#/$defs/sha"},
    "source_dry_run_plan": {"type": "object", "required": ["path", "file_sha256", "plan_sha256"], "properties": {"path": {"type": "string"}, "file_sha256": {"$ref": "#/$defs/sha"}, "plan_sha256": {"$ref": "#/$defs/sha"}}, "additionalProperties": false},
    "allowed_buckets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "maximum_total_bytes": {"type": "integer", "minimum": 0},
    "one_time_use": {"const": true},
    "authorization_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": true
}
