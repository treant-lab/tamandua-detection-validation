{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/mobile_device_identity_apple_recurring_assertion_contract_v1.schema.json",
  "title": "Tamandua Apple recurring assertion source-only contract",
  "oneOf": [
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/vector_corpus"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_binding_digest", "expected_tenant_binding_digest",
        "installation_binding_digest", "expected_installation_binding_digest",
        "profile_binding_digest", "expected_profile_binding_digest",
        "environment_binding_digest", "expected_environment_binding_digest",
        "team_binding_digest", "expected_team_binding_digest",
        "bundle_binding_digest", "expected_bundle_binding_digest",
        "provider_key_reference_digest", "active_provider_key_reference_digest",
        "challenge_reference_digest", "expected_challenge_reference_digest",
        "parent_receipt_digest", "expected_parent_receipt_digest",
        "stored_counter", "candidate_counter", "challenge_state",
        "verifier_authority_state", "rebind_state"
      ],
      "properties": {
        "tenant_binding_digest": {"$ref": "#/$defs/sha256"},
        "expected_tenant_binding_digest": {"$ref": "#/$defs/sha256"},
        "installation_binding_digest": {"$ref": "#/$defs/sha256"},
        "expected_installation_binding_digest": {"$ref": "#/$defs/sha256"},
        "profile_binding_digest": {"$ref": "#/$defs/sha256"},
        "expected_profile_binding_digest": {"$ref": "#/$defs/sha256"},
        "environment_binding_digest": {"$ref": "#/$defs/sha256"},
        "expected_environment_binding_digest": {"$ref": "#/$defs/sha256"},
        "team_binding_digest": {"$ref": "#/$defs/sha256"},
        "expected_team_binding_digest": {"$ref": "#/$defs/sha256"},
        "bundle_binding_digest": {"$ref": "#/$defs/sha256"},
        "expected_bundle_binding_digest": {"$ref": "#/$defs/sha256"},
        "provider_key_reference_digest": {"$ref": "#/$defs/sha256"},
        "active_provider_key_reference_digest": {"$ref": "#/$defs/sha256"},
        "challenge_reference_digest": {"$ref": "#/$defs/sha256"},
        "expected_challenge_reference_digest": {"$ref": "#/$defs/sha256"},
        "parent_receipt_digest": {"$ref": "#/$defs/sha256"},
        "expected_parent_receipt_digest": {"$ref": "#/$defs/sha256"},
        "stored_counter": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "candidate_counter": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "challenge_state": {"const": "pending"},
        "verifier_authority_state": {"const": "server_verifier_required_but_not_executed"},
        "rebind_state": {"const": "absent"}
      }
    },
    "category": {
      "enum": [
        "pending_runtime_authority", "invalid_contract_input", "invalid_digest_binding",
        "placeholder_digest_rejected", "digest_role_collision", "established_counter_required",
        "zero_counter_for_established_key", "counter_out_of_range", "equal_counter_replay",
        "counter_regression_or_clone", "challenge_already_consumed", "challenge_expired",
        "challenge_state_untrusted", "challenge_binding_mismatch", "parent_receipt_mismatch",
        "identity_binding_drift", "provider_key_authority_mismatch", "verifier_authority_missing",
        "recurring_assertion_cannot_rebind", "rebind_state_untrusted",
        "hold_requires_apple_verification_and_atomic_server_commit"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "authority_kind", "decision", "category",
        "eligible_for_future_atomic_transition", "prior_evidence_binding", "source_binding",
        "compiler_owned_observations", "compiler_owned_operations", "compiler_owned_outcomes", "compiler_scope", "claims",
        "future_atomic_transition"
      ],
      "properties": {
        "contract_version": {"const": "mobile_device_identity_apple_recurring_assertion_contract/v1"},
        "authority_kind": {"const": "source_only_pending_contract"},
        "decision": {"const": "HOLD"},
        "category": {"$ref": "#/$defs/category"},
        "eligible_for_future_atomic_transition": {"const": false},
