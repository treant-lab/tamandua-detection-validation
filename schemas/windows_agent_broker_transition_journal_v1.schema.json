{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/windows_agent_broker_transition_journal_v1.schema.json",
  "title": "Tamandua Windows Agent/Broker Transition Journal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transition_id", "transition_kind", "stage", "prior", "desired", "install_directory_sha256", "install_directory_identity", "session_reference_salt", "planned_session_refs", "prior_inventory", "desired_inventory", "desired_probes", "last_failure_phase", "last_failure_code", "actions"],
  "properties": {
    "schema_version": {"const": "tamandua.windows_agent_broker_transition_journal/v1"},
    "transition_id": {"$ref": "#/$defs/uuid"},
    "transition_kind": {"enum": ["MajorUpgrade", "Repair"]},
    "stage": {"enum": ["planned", "prepared", "desired_verified"]},
    "prior": {"$ref": "#/$defs/componentSet"},
    "desired": {"$ref": "#/$defs/componentSet"},
    "install_directory_sha256": {"$ref": "#/$defs/sha256"},
    "install_directory_identity": {"$ref": "#/$defs/directoryIdentity"},
    "session_reference_salt": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
    "planned_session_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/sessionRef"}},
    "prior_inventory": {"$ref": "#/$defs/inventory"},
    "desired_inventory": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/inventory"}]},
    "desired_probes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/probe"}},
    "last_failure_phase": {"oneOf": [{"type": "null"}, {"enum": ["prepare", "verify_desired", "commit", "recover"]}]},
    "last_failure_code": {"oneOf": [{"type": "null"}, {"enum": ["transition_phase_failed", "action_bound_exceeded"]}]},
    "actions": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/action"}}
  },
  "allOf": [
    {"if": {"properties": {"stage": {"enum": ["planned", "prepared"]}}}, "then": {"properties": {"desired_inventory": {"type": "null"}, "desired_probes": {"maxItems": 0}}}},
    {"if": {"properties": {"stage": {"const": "desired_verified"}}}, "then": {"properties": {"desired_inventory": {"$ref": "#/$defs/inventory"}}}},
    {"if": {"properties": {"last_failure_phase": {"type": "null"}}}, "then": {"properties": {"last_failure_code": {"type": "null"}}}, "else": {"properties": {"last_failure_code": {"type": "string"}}}}
  ],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sessionRef": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "directoryIdentity": {"type": "object", "additionalProperties": false, "required": ["path", "file_id"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 32767}, "file_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"}}},
    "componentSet": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_sha256", "sku", "agent_component_sha256", "broker_component_sha256"],
      "properties": {"manifest_sha256": {"$ref": "#/$defs/sha256"}, "sku": {"enum": ["AgentOnly", "BrokerEnabled"]}, "agent_component_sha256": {"$ref": "#/$defs/sha256"}, "broker_component_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}},
      "allOf": [
        {"if": {"properties": {"sku": {"const": "AgentOnly"}}}, "then": {"properties": {"broker_component_sha256": {"type": "null"}}}},
        {"if": {"properties": {"sku": {"const": "BrokerEnabled"}}}, "then": {"properties": {"broker_component_sha256": {"$ref": "#/$defs/sha256"}}}}
      ]
    },
    "inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["run_present", "service_present", "eligible_session_refs", "broker_process_count"],
      "properties": {"run_present": {"type": "boolean"}, "service_present": {"type": "boolean"}, "eligible_session_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/sessionRef"}}, "broker_process_count": {"type": "integer", "minimum": 0, "maximum": 64}}
    },
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["session_ref", "status", "component_sha256"],
      "properties": {"session_ref": {"$ref": "#/$defs/sessionRef"}, "status": {"const": "verified"}, "component_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "phase", "name", "status"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 128},
        "phase": {"enum": ["prepare", "verify_desired", "rollback", "commit", "recover"]},
        "name": {"enum": ["prior_inventory_and_probe_verified", "stop_verified_broker_process", "prepared", "phase_failed", "desired_inventory_and_probe_verified", "commit", "rollback_and_prior_probe_verified", "rollback_unverified", "recover_desired_verified", "recover_prior_verified", "recover_unknown"]},
        "status": {"enum": ["ok", "failed"]}
      }
    }
  }
}
