{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tamandua.local/anti_cheat_server_economy_action_replay_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "replay_id", "tenant_scope_digest", "build_digest", "session_digest", "policy_digest", "classification", "disposition", "observations", "extensions_influenced_suspicion", "evidence_class", "external_claim_allowed"],
  "properties": {
    "schema": {"const": "tamandua.anti_cheat.server_economy_action_replay/v1"},
    "replay_id": {"$ref": "#/$defs/digest"},
    "tenant_scope_digest": {"$ref": "#/$defs/digest"},
    "build_digest": {"$ref": "#/$defs/digest"},
    "session_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "classification": {"enum": ["within_constraints", "economy_violation", "action_violation", "inconclusive_gap", "inconclusive_conflict"]},
    "disposition": {"enum": ["observe", "emit_observation", "abstain"]},
    "observations": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/observation"}},
    "extensions_influenced_suspicion": {"const": false},
    "evidence_class": {"const": "synthetic_contract"},
    "external_claim_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"classification": {"enum": ["inconclusive_gap", "inconclusive_conflict"]}}, "required": ["classification"]},
      "then": {"properties": {"disposition": {"const": "abstain"}, "observations": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"classification": {"const": "within_constraints"}}, "required": ["classification"]},
      "then": {"properties": {"disposition": {"const": "observe"}, "observations": {"minItems": 2, "maxItems": 2}}}
    },
    {
      "if": {"properties": {"classification": {"enum": ["economy_violation", "action_violation"]}}, "required": ["classification"]},
      "then": {"properties": {"disposition": {"const": "emit_observation"}, "observations": {"minItems": 1, "maxItems": 1}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id_digest", "detector_family", "outcome", "reason_code", "evidence_digest", "start_tick", "end_tick", "feature_schema"],
      "properties": {
        "observation_id_digest": {"$ref": "#/$defs/digest"},
        "detector_family": {"enum": ["economy", "action"]},
        "outcome": {"enum": ["corroborated", "not_corroborated"]},
        "reason_code": {"enum": ["server_economy_within_constraints", "server_economy_constraint_violation", "server_action_within_constraints", "server_action_constraint_violation"]},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "start_tick": {"type": "integer", "minimum": 0},
        "end_tick": {"type": "integer", "minimum": 0},
        "feature_schema": {"enum": ["tamandua.game.economy_features/v1", "tamandua.game.action_features/v1"]}
      }
    }
  }
}
