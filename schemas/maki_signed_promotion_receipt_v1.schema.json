{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://tamandua.local/schemas/maki_signed_promotion_receipt_v1.schema.json","type":"object","additionalProperties":false,
  "required":["schema","payload","signature"],"properties":{
    "schema":{"const":"tamandua.maki.signed-promotion-receipt/v1"},
    "payload":{"type":"object","additionalProperties":false,"required":["schema","receipt_id","deployment_id","source_sha","preflight_packet_sha256","preflight_artifact_digest","promotion_manifest_sha256","live_receipt_schema_sha256","target","tier","bucket","region","publisher","sample","source","destination","coordinator_outcome","iam_verified","post_copy_verified","issued_at","expires_at"],"properties":{
      "schema":{"const":"tamandua.maki.promotion-receipt-payload/v1"},"receipt_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{7,127}$"},"deployment_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},"source_sha":{"type":"string","pattern":"^[0-9a-f]{40}([0-9a-f]{24})?$"},
      "preflight_packet_sha256":{"$ref":"#/$defs/sha"},"preflight_artifact_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"promotion_manifest_sha256":{"$ref":"#/$defs/sha"},"live_receipt_schema_sha256":{"$ref":"#/$defs/sha"},
      "target":{"const":"staging"},"tier":{"enum":["accepted","holdout"]},"bucket":{"type":"string","pattern":"^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"},"region":{"type":"string","pattern":"^[a-z]{2}(-gov)?-[a-z]+-[0-9]+$"},
      "publisher":{"type":"object","additionalProperties":false,"required":["owner","fencing_token"],"properties":{"owner":{"type":"string","minLength":1,"maxLength":160},"fencing_token":{"type":"integer","minimum":1}}},
      "sample":{"type":"object","additionalProperties":false,"required":["sha256","sample_class","size_bytes","split","source_id","source_evidence_sha256","leakage_group_id","observed_at","curation_manifest_sha256"],"properties":{"sha256":{"$ref":"#/$defs/sha"},"sample_class":{"enum":["goodware","malware"]},"size_bytes":{"type":"integer","minimum":1},"split":{"enum":["train","validation","holdout"]},"source_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_.-]{1,127}$"},"source_evidence_sha256":{"$ref":"#/$defs/sha"},"leakage_group_id":{"type":"string","minLength":1,"maxLength":256},"observed_at":{"type":"string","format":"date-time"},"curation_manifest_sha256":{"$ref":"#/$defs/sha"}}},
      "source":{"$ref":"#/$defs/identity"},"destination":{"$ref":"#/$defs/identity"},"coordinator_outcome":{"const":"succeeded"},"iam_verified":{"const":true},"post_copy_verified":{"const":true},"issued_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"}
    }},
    "signature":{"type":"object","additionalProperties":false,"required":["domain","algorithm","key_id","signature_b64"],"properties":{"domain":{"const":"tamandua.maki.live-promotion-receipt.ed25519/v1"},"algorithm":{"const":"Ed25519"},"key_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},"signature_b64":{"type":"string","pattern":"^[A-Za-z0-9+/]{86}==$"}}}
  },
  "$defs":{"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"identity":{"type":"object","additionalProperties":false,"required":["bucket","key","version_id","checksum_sha256","size_bytes"],"properties":{"bucket":{"type":"string","minLength":1},"key":{"type":"string","minLength":1},"version_id":{"type":"string","minLength":1},"checksum_sha256":{"$ref":"#/$defs/sha"},"size_bytes":{"type":"integer","minimum":1}}}}
}
