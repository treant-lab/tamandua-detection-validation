{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.io/schemas/maki_aws_version_export_config_v1.schema.json",
  "type": "object",
  "required": ["api_version", "source_revision", "prefixes", "head_checksum"],
  "properties": {
    "api_version": {"const": "tamandua.io/maki-aws-version-export-config/v1"},
    "source_revision": {"type": "string", "minLength": 1},
    "prefixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "page_size": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 1000},
    "head_checksum": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 16},
        "rate_per_second": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}
      },
      "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"required": ["max_concurrency", "rate_per_second"]}}],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
