{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/ai_agent_runtime_snapshot_v2.schema.json",
  "title": "Tamandua AI Agent Runtime Snapshot v2",
  "description": "Experimental full-fidelity snapshot with ordered unit and assembly manifests; no production or external claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "snapshot_id", "collected_at", "tenant", "endpoint", "source", "session", "capture", "governance", "integrity", "claims"],
  "properties": {
    "api_version": {"const": "tamandua.io/ai-agent-runtime-snapshot/v2"}, "kind": {"const": "AiAgentRuntimeSnapshot"},
    "snapshot_id": {"$ref": "#/$defs/id"}, "collected_at": {"type": "string", "format": "date-time"},
    "tenant": {"$ref": "#/$defs/tenant"}, "endpoint": {"$ref": "#/$defs/endpoint"}, "source": {"$ref": "#/$defs/source"},
    "session": {"type": "object", "additionalProperties": true, "required": ["provider", "session_id"], "properties": {"provider": {"enum": ["codex", "claude", "opencode"]}, "session_id": {"$ref": "#/$defs/id"}}},
    "capture": {"type": "object", "additionalProperties": true, "required": ["mode", "overall_status"], "properties": {"mode": {"const": "governed_full_fidelity"}, "overall_status": {"enum": ["complete", "degraded", "failed"]}}},
    "governance": {"$ref": "#/$defs/governance"}, "integrity": {"$ref": "#/$defs/integrity"}, "claims": {"$ref": "#/$defs/claims"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tenant": {"type": "object", "additionalProperties": false, "required": ["tenant_id", "organization_id"], "properties": {"tenant_id": {"$ref": "#/$defs/id"}, "organization_id": {"$ref": "#/$defs/id"}}},
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["agent_id", "device_id", "hostname", "platform"], "properties": {"agent_id": {"$ref": "#/$defs/id"}, "device_id": {"$ref": "#/$defs/id"}, "hostname": {"type": "string", "minLength": 1}, "platform": {"enum": ["windows", "linux", "macos"]}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["collector_id", "collector_version", "upstream_project", "upstream_commit", "upstream_license", "upstream_copyright"], "properties": {"collector_id": {"const": "tamandua.ai_agent_runtime"}, "collector_version": {"const": 2}, "upstream_project": {"const": "graykode/abtop"}, "upstream_commit": {"const": "a3328db20fe189887986e0147080954bc07178a1"}, "upstream_license": {"const": "MIT"}, "upstream_copyright": {"const": "Copyright (c) 2026 Tae Hwan Jung"}}},
    "governance": {"type": "object", "additionalProperties": false, "required": ["classification", "collection_basis", "access_policy_id", "retention_policy_id", "retention_days", "legal_hold", "encryption", "audit_required", "export_policy_id"], "properties": {"classification": {"const": "restricted_ai_agent_content"}, "collection_basis": {"type": "string", "minLength": 1}, "access_policy_id": {"$ref": "#/$defs/id"}, "retention_policy_id": {"$ref": "#/$defs/id"}, "retention_days": {"type": "integer", "minimum": 1}, "legal_hold": {"type": "boolean"}, "encryption": {"type": "object", "additionalProperties": false, "required": ["at_rest", "in_transit", "key_id"], "properties": {"at_rest": {"const": "aes-256-gcm"}, "in_transit": {"const": "tls-1.3"}, "key_id": {"$ref": "#/$defs/id"}}}, "audit_required": {"const": true}, "export_policy_id": {"$ref": "#/$defs/id"}}},
    "unit": {"type": "object", "additionalProperties": false, "required": ["sequence", "event_id", "event_type", "event_digest", "raw_evidence_sha256", "normalized_sha256", "chunk_id", "chunk_index", "chunk_count", "chunk_content_sha256", "full_content_sha256", "full_content_byte_length"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "event_id": {"$ref": "#/$defs/id"}, "event_type": {"type": "string", "minLength": 1}, "event_digest": {"$ref": "#/$defs/sha256"}, "raw_evidence_sha256": {"$ref": "#/$defs/sha256"}, "normalized_sha256": {"$ref": "#/$defs/sha256"}, "chunk_id": {"$ref": "#/$defs/id"}, "chunk_index": {"type": "integer", "minimum": 0}, "chunk_count": {"type": "integer", "minimum": 1}, "chunk_content_sha256": {"$ref": "#/$defs/sha256"}, "full_content_sha256": {"$ref": "#/$defs/sha256"}, "full_content_byte_length": {"type": "integer", "minimum": 0}}},
    "assembly": {"type": "object", "additionalProperties": false, "required": ["chunk_id", "chunk_count", "sequences", "chunk_content_sha256s", "full_content_sha256", "full_content_byte_length"], "properties": {"chunk_id": {"$ref": "#/$defs/id"}, "chunk_count": {"type": "integer", "minimum": 1}, "sequences": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}, "chunk_content_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}}, "full_content_sha256": {"$ref": "#/$defs/sha256"}, "full_content_byte_length": {"type": "integer", "minimum": 0}}},
    "manifest": {"type": "object", "additionalProperties": false, "required": ["version", "unit_count", "assembly_count", "units_sha256", "assemblies_sha256"], "properties": {"version": {"const": 1}, "unit_count": {"type": "integer", "minimum": 0}, "assembly_count": {"type": "integer", "minimum": 0}, "units_sha256": {"$ref": "#/$defs/sha256"}, "assemblies_sha256": {"$ref": "#/$defs/sha256"}}},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["version", "canonicalization", "algorithm", "stream_id", "first_sequence", "last_sequence", "event_count", "last_event_digest", "units", "assemblies", "manifest", "manifest_sha256", "snapshot_digest"], "properties": {"version": {"const": 2}, "canonicalization": {"const": "tmnd-tree-v1"}, "algorithm": {"const": "sha-256"}, "stream_id": {"$ref": "#/$defs/id"}, "first_sequence": {"type": ["integer", "null"], "minimum": 1}, "last_sequence": {"type": ["integer", "null"], "minimum": 1}, "event_count": {"type": "integer", "minimum": 0}, "last_event_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "units": {"type": "array", "items": {"$ref": "#/$defs/unit"}}, "assemblies": {"type": "array", "items": {"$ref": "#/$defs/assembly"}}, "manifest": {"$ref": "#/$defs/manifest"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "snapshot_digest": {"$ref": "#/$defs/sha256"}}},
    "claims": {"type": "object", "additionalProperties": false, "required": ["maturity", "evidence_class", "product_ready", "release_ready", "production_ready", "external_claims_allowed"], "properties": {"maturity": {"const": "experimental"}, "evidence_class": {"const": "contract_smoke"}, "product_ready": {"const": false}, "release_ready": {"const": false}, "production_ready": {"const": false}, "external_claims_allowed": {"const": false}}}
  }
}
