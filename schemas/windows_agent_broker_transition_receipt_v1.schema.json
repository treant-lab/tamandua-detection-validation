{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/windows_agent_broker_transition_receipt_v1.schema.json",
  "title": "Tamandua Windows Agent/Broker Transition Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "transition_kind",
    "install_directory_sha256",
    "install_directory_identity",
    "prior",
    "desired",
    "outcome",
    "failure_phase",
    "failure_code",
    "planned_session_refs",
    "final_inventory",
    "probes",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": "tamandua.windows_agent_broker_transition_receipt/v1"
    },
    "transition_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "transition_kind": { "enum": ["MajorUpgrade", "Repair"] },
    "install_directory_sha256": { "$ref": "#/$defs/sha256" },
    "install_directory_identity": { "$ref": "#/$defs/directoryIdentity" },
    "prior": { "$ref": "#/$defs/componentSet" },
    "desired": { "$ref": "#/$defs/componentSet" },
    "outcome": {
      "enum": ["committed_verified", "rolled_back_verified", "outcome_unknown"]
    },
    "failure_phase": {
      "oneOf": [
        { "type": "null" },
        {
          "enum": [
            "prepare",
            "verify_desired",
            "rollback",
            "commit",
            "recover"
          ]
        }
      ]
    },
    "failure_code": {
      "oneOf": [
        { "type": "null" },
        {
          "enum": ["transition_phase_failed", "action_bound_exceeded", "rollback_requested", "crash_recovered"]
        }
      ]
    },
    "planned_session_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sessionRef" }
    },
    "final_inventory": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/inventory" }
      ]
    },
    "probes": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/probe" }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "committed_verified" } } },
      "then": {
        "properties": {
          "failure_phase": { "type": "null" },
          "failure_code": { "type": "null" },
          "final_inventory": { "$ref": "#/$defs/inventory" }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "rolled_back_verified" } } },
      "then": {
        "properties": {
          "failure_phase": { "type": "string" },
          "failure_code": { "type": "string" },
          "final_inventory": { "$ref": "#/$defs/inventory" }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "outcome_unknown" } } },
      "then": {
        "properties": {
          "failure_phase": { "type": "string" },
          "failure_code": { "type": "string" },
          "final_inventory": { "type": "null" },
          "probes": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sessionRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "directoryIdentity": {
      "type": "object", "additionalProperties": false, "required": ["path", "file_id"],
      "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 32767}, "file_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"}}
    },
    "componentSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "sku", "agent_component_sha256", "broker_component_sha256"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "sku": { "enum": ["AgentOnly", "BrokerEnabled"] },
        "agent_component_sha256": { "$ref": "#/$defs/sha256" },
        "broker_component_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "sku": { "const": "AgentOnly" } } },
          "then": { "properties": { "broker_component_sha256": { "type": "null" } } }
        },
        {
          "if": { "properties": { "sku": { "const": "BrokerEnabled" } } },
          "then": {
            "properties": {
              "broker_component_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_present",
        "service_present",
        "eligible_session_refs",
        "broker_process_count"
      ],
      "properties": {
        "run_present": { "type": "boolean" },
        "service_present": { "type": "boolean" },
        "eligible_session_refs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sessionRef" }
        },
        "broker_process_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_ref", "status", "component_sha256"],
      "properties": {
        "session_ref": { "$ref": "#/$defs/sessionRef" },
        "status": { "const": "verified" },
        "component_sha256": {
          "description": "SHA-256 of the exact component-set manifest authenticated by the broker probe; this is not the broker executable image hash.",
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "phase", "name", "status"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 128 },
        "phase": {
          "enum": [
            "prepare",
            "verify_desired",
            "rollback",
            "commit",
            "recover"
          ]
        },
        "name": {
          "enum": [
            "prior_inventory_and_probe_verified",
            "stop_verified_broker_process",
            "prepared",
            "phase_failed",
            "desired_inventory_and_probe_verified",
            "commit",
            "rollback_and_prior_probe_verified",
            "rollback_unverified",
            "recover_desired_verified",
            "recover_prior_verified",
            "recover_unknown"
          ]
        },
        "status": { "enum": ["ok", "failed"] }
      }
    }
  }
}
