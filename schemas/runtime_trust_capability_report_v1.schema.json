{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tamandua.local/runtime_trust_capability_report_v1.schema.json",
  "title": "Tamandua Runtime Trust Capability Report v1",
  "type": "object",
  "required": ["adapter_id", "adapter_version", "state", "missing_capabilities", "degraded_reasons"],
  "properties": {
    "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
    "adapter_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "state": {"enum": ["supported", "degraded", "unsupported"]},
    "missing_capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$"}
    },
    "degraded_reasons": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "capabilities": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["capability_id", "state", "evidence_status", "limitations"],
        "properties": {
          "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$"},
          "state": {"enum": ["supported", "degraded", "unsupported", "not_applicable"]},
          "evidence_status": {
            "enum": ["implemented", "source_validated", "physical_lab", "governed", "unsupported", "not_applicable"]
          },
          "limitations": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "allOf": [
          {
            "if": {"properties": {"state": {"const": "supported"}}},
            "then": {
              "properties": {
                "evidence_status": {
                  "enum": ["implemented", "source_validated", "physical_lab", "governed"]
                }
              }
            }
          },
          {
            "if": {"properties": {"state": {"const": "unsupported"}}},
            "then": {"properties": {"evidence_status": {"const": "unsupported"}}}
          },
          {
            "if": {"properties": {"state": {"const": "not_applicable"}}},
            "then": {"properties": {"evidence_status": {"const": "not_applicable"}}}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "supported"}}},
      "then": {
        "properties": {
          "missing_capabilities": {"maxItems": 0},
          "degraded_reasons": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "unsupported"}}},
      "then": {
        "properties": {
          "missing_capabilities": {"minItems": 1},
          "degraded_reasons": {"minItems": 1},
          "capabilities": {
            "items": {
              "properties": {
                "state": {"enum": ["unsupported", "not_applicable"]}
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
