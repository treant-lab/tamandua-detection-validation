{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.invalid/schemas/android_hardware_identity_physical_collection_plan_v1.schema.json",
  "title": "Android hardware identity physical collection offline plan v1",
  "description": "Strict offline plan. JSON Schema fixes asset position and unique role multiplicity; cross-object scenario reference and role correspondence are additionally enforced by the authoritative Node validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidence_class", "decision", "request_sha256", "bindings", "authorization", "assets", "capability_expectations", "selection_policy", "matrix", "matrix_sha256", "controls", "independent_verification_prerequisites", "execution", "claims"],
  "properties": {
    "schema": {"const": "tamandua.android_hardware_identity.physical_collection_plan/v1"},
    "evidence_class": {"const": "local_offline_plan"},
    "decision": {"const": "hold"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apk_installed_bytes_sha256", "apk_signer_certificate_sha256", "apk_version_binding_sha256", "backend_source_sha256", "native_source_sha256", "template_source_sha256", "native_template_parity_sha256", "attestation_trust_root_sha256", "attestation_policy_sha256", "tenant_identity_policy_sha256", "collector_source_sha256"],
      "properties": {
        "apk_installed_bytes_sha256": {"$ref": "#/$defs/sha256"},
        "apk_signer_certificate_sha256": {"$ref": "#/$defs/sha256"},
        "apk_version_binding_sha256": {"$ref": "#/$defs/sha256"},
        "backend_source_sha256": {"$ref": "#/$defs/sha256"},
        "native_source_sha256": {"$ref": "#/$defs/sha256"},
        "template_source_sha256": {"$ref": "#/$defs/sha256"},
        "native_template_parity_sha256": {"$ref": "#/$defs/sha256"},
        "attestation_trust_root_sha256": {"$ref": "#/$defs/sha256"},
        "attestation_policy_sha256": {"$ref": "#/$defs/sha256"},
        "tenant_identity_policy_sha256": {"$ref": "#/$defs/sha256"},
        "collector_source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lab_authorization_receipt_sha256", "device_lease_receipt_sha256", "operator_authorization_receipt_sha256", "rebind_authorization_policy_sha256", "isolation_plan_sha256", "backup_manifest_sha256", "rollback_plan_sha256", "redaction_policy_sha256", "independent_verifier_plan_sha256"],
      "properties": {
        "lab_authorization_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "device_lease_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "operator_authorization_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "rebind_authorization_policy_sha256": {"$ref": "#/$defs/sha256"},
        "isolation_plan_sha256": {"$ref": "#/$defs/sha256"},
        "backup_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "rollback_plan_sha256": {"$ref": "#/$defs/sha256"},
        "redaction_policy_sha256": {"$ref": "#/$defs/sha256"},
        "independent_verifier_plan_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "assets": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/asset"}, {"properties": {"ordinal": {"const": 1}}}]},
        {"allOf": [{"$ref": "#/$defs/asset"}, {"properties": {"ordinal": {"const": 2}}}]},
        {"allOf": [{"$ref": "#/$defs/asset"}, {"properties": {"ordinal": {"const": 3}}}]}
      ],
      "items": false,
      "allOf": [
        {"contains": {"properties": {"capability_role": {"const": "strongbox"}}, "required": ["capability_role"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"capability_role": {"const": "tee"}}, "required": ["capability_role"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"capability_role": {"const": "unsupported"}}, "required": ["capability_role"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "capability_expectations": {"const": {"strongbox": "strongbox_expected_not_assumed", "tee": "tee_expected_not_assumed", "unsupported": "unsupported_or_software_fallback_expected_not_assumed"}},
    "selection_policy": {"const": {"primary_role": "strongbox", "comparison_roles": ["strongbox", "tee"], "unsupported_role": "unsupported", "unsupported_in_scenario_matrix": false, "unsupported_disposition": "record_capability_gap_without_identity_or_continuity_claim"}},
    "matrix": {
      "type": "array", "minItems": 15, "maxItems": 15,
      "prefixItems": [
        {"$ref": "#/$defs/scenario_01"}, {"$ref": "#/$defs/scenario_02"}, {"$ref": "#/$defs/scenario_03"},
        {"$ref": "#/$defs/scenario_04"}, {"$ref": "#/$defs/scenario_05"}, {"$ref": "#/$defs/scenario_06"},
        {"$ref": "#/$defs/scenario_07"}, {"$ref": "#/$defs/scenario_08"}, {"$ref": "#/$defs/scenario_09"},
        {"$ref": "#/$defs/scenario_10"}, {"$ref": "#/$defs/scenario_11"}, {"$ref": "#/$defs/scenario_12"},
        {"$ref": "#/$defs/scenario_13"}, {"$ref": "#/$defs/scenario_14"}, {"$ref": "#/$defs/scenario_15"}
      ],
      "items": false
    },
    "matrix_sha256": {"$ref": "#/$defs/sha256"},
    "controls": {"const": {"isolated_lab_required": true, "backups_required": true, "rollback_required": true, "independent_verification_required": true, "aliases_and_ordinals_only": true, "raw_identifiers_forbidden": true, "raw_attestation_forbidden": true, "secrets_forbidden": true}},
    "independent_verification_prerequisites": {"const": ["recompute_all_declared_sha256_bindings", "verify_authorization_and_device_lease_receipts", "verify_installed_apk_bytes_signer_and_version", "verify_native_template_parity_and_collector_source", "verify_attestation_trust_root_policy_and_freshness", "verify_tenant_scoping_replay_and_rebind_policy", "verify_backup_rollback_isolation_and_redaction", "independent_reviewer_signoff_before_collection"]},
    "execution": {"const": {"executed": false, "adb_operations": 0, "device_operations": 0, "native_key_operations": 0, "network_operations": 0, "backend_operations": 0}},
    "claims": {"const": {"physical_device_validated": false, "hardware_attestation_validated": false, "continuity_validated": false, "global_hardware_guid_validated": false, "cross_tenant_unlinkability_validated": false, "product_ready": false, "production_ready": false, "external_claim_allowed": false, "verimatrix_parity": false}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_alias", "capability_role", "ordinal"],
      "properties": {
        "asset_alias": {"type": "string", "pattern": "^lab-device-(strongbox|tee|unsupported)-0[1-3]$"},
        "capability_role": {"enum": ["strongbox", "tee", "unsupported"]},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 3}
      },
      "allOf": [
        {"if": {"properties": {"capability_role": {"const": "strongbox"}}}, "then": {"properties": {"asset_alias": {"pattern": "^lab-device-strongbox-0[1-3]$"}}}},
        {"if": {"properties": {"capability_role": {"const": "tee"}}}, "then": {"properties": {"asset_alias": {"pattern": "^lab-device-tee-0[1-3]$"}}}},
        {"if": {"properties": {"capability_role": {"const": "unsupported"}}}, "then": {"properties": {"asset_alias": {"pattern": "^lab-device-unsupported-0[1-3]$"}}}}
      ]
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "name", "asset_ordinals", "tenant_scope", "expected_key_relation", "expected_server_decision", "recovery_requirement", "authorization_requirement"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 15},
        "name": {"type": "string"},
        "asset_ordinals": {"description": "References must be declared, select only supported roles and match the role-driven policy; authoritative cross-object enforcement is performed by validatePlan.", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 3}},
        "tenant_scope": {"enum": ["tenant_a", "tenant_pair"]},
        "expected_key_relation": {"enum": ["new_per_installation_key_expected", "continuous_only_if_same_hardware_key", "key_loss_expected", "distinct_keys_required", "tenant_scoped_pseudonyms_must_differ", "same_key_replayed_proof", "same_key_stale_challenge", "copied_material_must_not_prove_possession", "old_to_new_key_transition", "competing_new_keys", "same_request_same_key"]},
        "expected_server_decision": {"enum": ["hold_for_physical_evidence", "explicit_recovery_required", "reject_key_collision", "reject_cross_tenant_linkage", "reject_replay", "reject_stale", "reject_clone", "accept_once_if_fully_authorized", "reject_unauthorized_rebind", "serialize_single_authority", "idempotent_same_receipt_no_second_key"]},
        "recovery_requirement": {"enum": ["not_applicable", "investigate_on_key_loss", "authorized_reenrollment_required", "deny", "authorized_rebind_only"]},
        "authorization_requirement": {"enum": ["lab_and_device_lease", "rebind_receipt_required", "two_tenant_authorization", "authorization_absent"]}
      }
    },
    "scenario_01": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"ordinal": {"const": 1}, "name": {"const": "baseline_key_creation"}, "tenant_scope": {"const": "tenant_a"}, "expected_key_relation": {"const": "new_per_installation_key_expected"}, "expected_server_decision": {"const": "hold_for_physical_evidence"}, "recovery_requirement": {"const": "not_applicable"}, "authorization_requirement": {"const": "lab_and_device_lease"}}}]},
    "scenario_02": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"ordinal": {"const": 2}, "name": {"const": "reboot_continuity"}, "tenant_scope": {"const": "tenant_a"}, "expected_key_relation": {"const": "continuous_only_if_same_hardware_key"}, "expected_server_decision": {"const": "hold_for_physical_evidence"}, "recovery_requirement": {"const": "investigate_on_key_loss"}, "authorization_requirement": {"const": "lab_and_device_lease"}}}]},
    "scenario_03": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"ordinal": {"const": 3}, "name": {"const": "app_update_continuity"}, "tenant_scope": {"const": "tenant_a"}, "expected_key_relation": {"const": "continuous_only_if_same_hardware_key"}, "expected_server_decision": {"const": "hold_for_physical_evidence"}, "recovery_requirement": {"const": "investigate_on_key_loss"}, "authorization_requirement": {"const": "lab_and_device_lease"}}}]},
    "scenario_04": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"ordinal": {"const": 4}, "name": {"const": "os_update_continuity"}, "tenant_scope": {"const": "tenant_a"}, "expected_key_relation": {"const": "continuous_only_if_same_hardware_key"}, "expected_server_decision": {"const": "hold_for_physical_evidence"}, "recovery_requirement": {"const": "investigate_on_key_loss"}, "authorization_requirement": {"const": "lab_and_device_lease"}}}]},
    "scenario_05": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"ordinal": {"const": 5}, "name": {"const": "clear_data_key_loss_recovery"}, "tenant_scope": {"const": "tenant_a"}, "expected_key_relation": {"const": "key_loss_expected"}, "expected_server_decision": {"const": "explicit_recovery_required"}, "recovery_requirement": {"const": "authorized_reenrollment_required"}, "authorization_requirement": {"const": "rebind_receipt_required"}}}]},
    "scenario_06": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"ordinal": {"const": 6}, "name": {"const": "uninstall_reinstall_key_loss_recovery"}, "tenant_scope": {"const": "tenant_a"}, "expected_key_relation": {"const": "key_loss_expected"}, "expected_server_decision": {"const": "explicit_recovery_required"}, "recovery_requirement": {"const": "authorized_reenrollment_required"}, "authorization_requirement": {"const": "rebind_receipt_required"}}}]},
    "scenario_07": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"ordinal": {"const": 7}, "name": {"const": "cross_device_distinction"}, "tenant_scope": {"const": "tenant_a"}, "expected_key_relation": {"const": "distinct_keys_required"}, "expected_server_decision": {"const": "reject_key_collision"}, "recovery_requirement": {"const": "deny"}, "authorization_requirement": {"const": "lab_and_device_lease"}}}]},
    "scenario_08": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"ordinal": {"const": 8}, "name": {"const": "cross_tenant_unlinkability"}, "tenant_scope": {"const": "tenant_pair"}, "expected_key_relation": {"const": "tenant_scoped_pseudonyms_must_differ"}, "expected_server_decision": {"const": "reject_cross_tenant_linkage"}, "recovery_requirement": {"const": "deny"}, "authorization_requirement": {"const": "two_tenant_authorization"}}}]},
    "scenario_09": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"ordinal": {"const": 9}, "name": {"const": "replay_rejection"}, "tenant_scope": {"const": "tenant_a"}, "expected_key_relation": {"const": "same_key_replayed_proof"}, "expected_server_decision": {"const": "reject_replay"}, "recovery_requirement": {"const": "deny"}, "authorization_requirement": {"const": "lab_and_device_lease"}}}]},
    "scenario_10": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"ordinal": {"const": 10}, "name": {"const": "stale_challenge_rejection"}, "tenant_scope": {"const": "tenant_a"}, "expected_key_relation": {"const": "same_key_stale_challenge"}, "expected_server_decision": {"const": "reject_stale"}, "recovery_requirement": {"const": "deny"}, "authorization_requirement": {"const": "lab_and_device_lease"}}}]},
    "scenario_11": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"ordinal": {"const": 11}, "name": {"const": "clone_rejection"}, "tenant_scope": {"const": "tenant_a"}, "expected_key_relation": {"const": "copied_material_must_not_prove_possession"}, "expected_server_decision": {"const": "reject_clone"}, "recovery_requirement": {"const": "deny"}, "authorization_requirement": {"const": "lab_and_device_lease"}}}]},
    "scenario_12": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"ordinal": {"const": 12}, "name": {"const": "authorized_rebind_acceptance"}, "tenant_scope": {"const": "tenant_a"}, "expected_key_relation": {"const": "old_to_new_key_transition"}, "expected_server_decision": {"const": "accept_once_if_fully_authorized"}, "recovery_requirement": {"const": "authorized_rebind_only"}, "authorization_requirement": {"const": "rebind_receipt_required"}}}]},
    "scenario_13": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"ordinal": {"const": 13}, "name": {"const": "unauthorized_rebind_rejection"}, "tenant_scope": {"const": "tenant_a"}, "expected_key_relation": {"const": "old_to_new_key_transition"}, "expected_server_decision": {"const": "reject_unauthorized_rebind"}, "recovery_requirement": {"const": "deny"}, "authorization_requirement": {"const": "authorization_absent"}}}]},
    "scenario_14": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"ordinal": {"const": 14}, "name": {"const": "concurrent_rebind_serialization"}, "tenant_scope": {"const": "tenant_a"}, "expected_key_relation": {"const": "competing_new_keys"}, "expected_server_decision": {"const": "serialize_single_authority"}, "recovery_requirement": {"const": "authorized_rebind_only"}, "authorization_requirement": {"const": "rebind_receipt_required"}}}]},
    "scenario_15": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"ordinal": {"const": 15}, "name": {"const": "idempotent_retry"}, "tenant_scope": {"const": "tenant_a"}, "expected_key_relation": {"const": "same_request_same_key"}, "expected_server_decision": {"const": "idempotent_same_receipt_no_second_key"}, "recovery_requirement": {"const": "not_applicable"}, "authorization_requirement": {"const": "rebind_receipt_required"}}}]}
  }
}
