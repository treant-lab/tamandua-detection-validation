{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.io/schemas/external_model_intake_attestation_v1.schema.json",
  "title": "Tamandua External Model Intake Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "attestation_id", "candidate", "download", "quarantine", "scans", "decision", "created_at", "signature"],
  "properties": {
    "api_version": {"const": "tamandua.io/external-model-intake-attestation/v1"},
    "attestation_id": {"type": "string", "minLength": 8},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "revision", "artifact_name"],
      "properties": {
        "model_id": {"type": "string", "minLength": 3},
        "revision": {"type": "string", "minLength": 7, "not": {"enum": ["main", "master", "latest", "pinned-before-use"]}},
        "artifact_name": {"type": "string", "minLength": 1}
      }
    },
    "download": {
      "type": "object", "additionalProperties": false,
      "required": ["source_uri", "sha256", "size_bytes", "completed_at"],
      "properties": {
        "source_uri": {"type": "string", "minLength": 3},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "quarantine": {
      "type": "object", "additionalProperties": false,
      "required": ["quarantine_id", "path", "immutable"],
      "properties": {
        "quarantine_id": {"type": "string", "minLength": 3},
        "path": {"type": "string", "minLength": 3},
        "immutable": {"const": true}
      }
    },
    "scans": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["engine", "version", "status", "findings", "scanned_at"],
        "properties": {
          "engine": {"type": "string", "minLength": 2},
          "version": {"type": "string", "minLength": 1},
          "status": {"enum": ["clean", "threat", "error", "unsupported"]},
          "findings": {"type": "array", "items": {"type": "string"}},
          "scanned_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "allowed_uses", "approved_by"],
      "properties": {
        "status": {"enum": ["approved", "blocked", "needs_review"]},
        "allowed_uses": {"type": "array", "uniqueItems": true, "items": {"enum": ["benchmark", "shadow", "detect_only", "enforced"]}},
        "approved_by": {"type": "string", "minLength": 3},
        "reason": {"type": "string"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"enum": ["ed25519", "hmac-sha256"]},
        "key_id": {"type": "string", "minLength": 3},
        "value": {"type": "string", "minLength": 32}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"properties": {"status": {"const": "approved"}}}}},
 "then": {
 "properties": {
 "scans": {
 "contains": {
 "properties": {"status": {"const": "clean"}},
 "required": ["status"]
 },
 "not": {
 "contains": {
 "properties": {"status": {"enum": ["threat", "error"]}},
 "required": ["status"]
 }
 }
 }
 }
 }
    },
    {
 "if": {"properties": {"decision": {"properties": {"allowed_uses": {"contains": {"const": "enforced"}}}}}},
 "then": {
 "properties": {
 "decision": {
 "properties": {
 "status": {"const": "approved"}
 }
 },
 "signature": {
 "properties": {
 "algorithm": {"const": "ed25519"}
 }
 }
 }
 }
    }
  ]
}
