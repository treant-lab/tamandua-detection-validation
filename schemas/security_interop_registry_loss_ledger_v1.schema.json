{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/security_interop_registry_loss_ledger_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ledger_version", "registry_entry_id", "status", "losses"],
  "properties": {
    "ledger_version": {"const": "1.0.0"},
    "registry_entry_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["not_assessed", "assessed", "accepted"]},
    "losses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "direction", "impact", "disposition"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "direction": {"enum": ["tamandua_to_external", "external_to_tamandua", "both"]},
          "impact": {"enum": ["none", "low", "medium", "high"]},
          "disposition": {"enum": ["open", "accepted", "mitigated"]}
        }
      }
    }
  }
}
