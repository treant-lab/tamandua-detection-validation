{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/maki_publisher_preflight_packet_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "evidence_class", "offline_preflight_eligible", "clean_head_verified", "workspace_receipt_verified", "coordinator_enqueue_verified", "approval_recorded", "deployment", "inputs", "selection", "destination", "source_objects", "postconditions", "execution", "claim_boundary"],
  "properties": {
    "api_version": {"const": "tamandua.io/maki-publisher-preflight-packet/v1"},
    "kind": {"const": "MakiPublisherPreflightPacket"},
    "evidence_class": {"const": "offline_publisher_preflight"},
    "offline_preflight_eligible": {"const": true},
    "clean_head_verified": {"const": false},
    "workspace_receipt_verified": {"const": false},
    "coordinator_enqueue_verified": {"const": false},
    "approval_recorded": {"const": false},
    "deployment": {
      "type": "object", "additionalProperties": false,
      "required": ["deployment_id", "source_sha", "target", "surface"],
      "properties": {
        "deployment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "target": {"const": "staging"}, "surface": {"const": "ml-corpus"}
      }
    },
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["promotion_manifest_sha256", "accepted_dry_run_sha256", "packet_schema_sha256"],
      "properties": {
        "promotion_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "accepted_dry_run_sha256": {"$ref": "#/$defs/sha256"},
        "packet_schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["tier", "selected_count", "holdout_selected"],
      "properties": {"tier": {"const": "accepted"}, "selected_count": {"type": "integer", "minimum": 1}, "holdout_selected": {"const": false}}
    },
    "destination": {
      "type": "object", "additionalProperties": false,
      "required": ["bucket", "prefix"],
      "properties": {"bucket": {"type": "string", "minLength": 1}, "prefix": {"const": "accepted/"}}
    },
    "source_objects": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sha256", "source", "destination_key", "split"],
        "properties": {
          "sha256": {"$ref": "#/$defs/sha256"},
          "source": {"$ref": "#/$defs/identity"},
          "destination_key": {"type": "string", "pattern": "^accepted/(goodware|malware)/.+/[0-9a-f]{64}\\.bin$"},
          "split": {"enum": ["train", "validation"]}
        }
      }
    },
    "postconditions": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinator_approval_required", "coordinator_artifact_verification_required", "publisher_lease_and_fencing_required", "iam_verification_required", "post_copy_version_checksum_size_receipt_required"],
      "properties": {
        "coordinator_approval_required": {"const": true},
        "coordinator_artifact_verification_required": {"const": true},
        "publisher_lease_and_fencing_required": {"const": true},
        "iam_verification_required": {"const": true},
        "post_copy_version_checksum_size_receipt_required": {"const": true}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["execution_authorized", "aws_mutation_performed", "iam_verified", "uses_network"],
      "properties": {"execution_authorized": {"const": false}, "aws_mutation_performed": {"const": false}, "iam_verified": {"const": false}, "uses_network": {"const": false}}
    },
    "claim_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["supports", "does_not_support"],
      "properties": {
        "supports": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "does_not_support": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["bucket", "key", "version_id", "checksum_sha256", "size_bytes"],
      "properties": {
        "bucket": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1},
        "version_id": {"type": "string", "minLength": 1}, "checksum_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
