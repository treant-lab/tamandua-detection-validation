{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/artifact_hardening_receipt_v1.schema.json",
  "title": "Tamandua artifact hardening receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "target", "policy", "state", "artifacts", "package_inventory", "deliverable_exclusions", "limitations"],
  "properties": {
    "schema_id": {"const": "tamandua.artifact_hardening_receipt/v1"},
    "target": {"type": "string", "minLength": 3, "maxLength": 128},
    "policy": {"enum": ["release", "hardened"]},
    "state": {"enum": ["passed", "failed"]},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "package_inventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/inventory"}
    },
    "deliverable_exclusions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 128},
          "reason": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 512},
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\u007f]+$", "maxLength": 512},
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "kind": {"enum": ["executable", "data"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 4294967296}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "requirement", "state", "detail"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 64},
        "requirement": {"enum": ["required", "advisory"]},
        "state": {"enum": ["pass", "fail", "not_detected"]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256", "size", "format", "arch", "state", "checks"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "kind": {"const": "executable"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "format": {"enum": ["elf", "pe", "macho", "unknown"]},
        "arch": {"type": "string", "minLength": 1, "maxLength": 64},
        "state": {"enum": ["passed", "failed"]},
        "checks": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/check"}},
        "slices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/slice"}
        }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch", "cpu_type", "cpu_subtype", "offset", "size", "sha256", "state", "checks"],
      "properties": {
        "arch": {"enum": ["x86_64", "arm64"]},
        "cpu_type": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "cpu_subtype": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "offset": {"type": "integer", "minimum": 0, "maximum": 4294967296},
        "size": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "sha256": {"$ref": "#/$defs/sha256"},
        "state": {"enum": ["passed", "failed"]},
        "checks": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/check"}}
      }
    }
  }
}
