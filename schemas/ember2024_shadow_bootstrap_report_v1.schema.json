{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.io/schemas/ember2024_shadow_bootstrap_report_v1.schema.json",
  "title": "Tamandua EMBER2024 Shadow Bootstrap Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version", "kind", "created_at", "evidence_class", "claim_status",
    "model", "dataset", "metrics", "score_receipt", "reproducibility", "claim_boundary"
  ],
  "properties": {
    "api_version": {"const": "tamandua.io/ember2024-shadow-bootstrap-report/v1"},
    "kind": {"const": "EMBER2024ShadowBootstrapReport"},
    "created_at": {"type": "string", "format": "date-time"},
    "evidence_class": {"const": "bootstrap_shadow"},
    "claim_status": {"const": "local_exploratory_not_production"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id", "revision", "artifact_sha256", "policy_decision",
        "policy_hmac_validated_before_load", "may_block", "decision_mode",
        "extractor", "lightgbm_version"
      ],
      "properties": {
        "model_id": {"type": "string", "minLength": 3},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "policy_decision": {"const": "allow_shadow"},
        "policy_hmac_validated_before_load": {"const": true},
        "may_block": {"const": false},
        "decision_mode": {"const": "score_only_shadow"},
        "lightgbm_version": {"type": "string", "minLength": 1},
        "extractor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distribution", "version", "revision", "source_url"],
          "properties": {
            "distribution": {"const": "thrember"},
            "version": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            "source_url": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection", "seed", "workers", "requested_per_class", "scored",
        "member_set_sha256", "lineage", "body_or_scoring_failures", "labels",
        "governed_holdout", "license_approval_for_training"
      ],
      "properties": {
        "selection": {"const": "sha256_ranked_deterministic_without_replacement"},
        "seed": {"type": "string", "minLength": 1},
        "workers": {"type": "integer", "minimum": 1},
        "requested_per_class": {"type": "integer", "minimum": 1},
        "scored": {"$ref": "#/$defs/classCounts"},
        "member_set_sha256": {"$ref": "#/$defs/classHashes"},
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["receipts", "metadata_eligible", "metadata_rejections"],
          "properties": {
            "receipts": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "path", "sha256", "root", "rows"],
                "properties": {
                  "label": {"enum": ["goodware", "malware"]},
                  "path": {"type": "string", "minLength": 1},
                  "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                  "root": {"type": "string", "minLength": 1},
                  "rows": {"type": "integer", "minimum": 0}
                }
              }
            },
            "metadata_eligible": {"$ref": "#/$defs/classCounts"},
            "metadata_rejections": {"$ref": "#/$defs/reasonCounts"}
          }
        },
        "body_or_scoring_failures": {"$ref": "#/$defs/reasonCounts"},
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["goodware", "malware"],
          "properties": {
            "goodware": {"type": "string", "minLength": 10},
            "malware": {"type": "string", "minLength": 10}
          }
        },
        "governed_holdout": {"const": false},
        "license_approval_for_training": {"const": false}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roc_auc", "score_orientation", "latency_ms", "withheld"],
      "properties": {
        "roc_auc": {"type": "number", "minimum": 0, "maximum": 1},
        "score_orientation": {"const": "higher_is_more_malicious"},
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mean", "p50", "p95"],
          "properties": {
            "mean": {"type": "number", "minimum": 0},
            "p50": {"type": "number", "minimum": 0},
            "p95": {"type": "number", "minimum": 0}
          }
        },
        "withheld": {
          "type": "object",
          "additionalProperties": false,
          "required": ["threshold", "fpr", "fnr"],
          "properties": {
            "threshold": {"type": "string", "minLength": 10},
            "fpr": {"type": "string", "minLength": 10},
            "fnr": {"type": "string", "minLength": 10}
          }
        }
      }
    },
    "score_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "rows"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rows": {"type": "integer", "minimum": 2}
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "git_commit"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "git_commit": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports", "does_not_support"],
      "properties": {
        "supports": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
        "does_not_support": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}}
      }
    }
  },
  "$defs": {
    "classCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goodware", "malware"],
      "properties": {
        "goodware": {"type": "integer", "minimum": 0},
        "malware": {"type": "integer", "minimum": 0}
      }
    },
    "classHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goodware", "malware"],
      "properties": {
        "goodware": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "malware": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "reasonCounts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    }
  }
}
