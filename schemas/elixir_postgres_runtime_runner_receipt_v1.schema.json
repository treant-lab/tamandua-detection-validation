{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tamandua.local/elixir_postgres_runtime_runner_receipt_v1.schema.json",
  "title": "Tamandua Elixir/PostgreSQL runtime validation runner receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "generated_at", "status", "claims", "claim_boundary"],
  "properties": {
    "schema_version": {"const": 1},
    "diagnostic_contract_version": {"enum": [1, 2]},
    "profile_id": {"const": "elixir-postgres-runtime-runner-build"},
    "generated_at": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["inspect", "execute"]},
    "status": {"enum": ["blocked", "pass"]},
    "invocation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{7,63}$", "not": {"const": "latest"}},
    "tag": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]{2,127}:[a-f0-9]{12}-[a-z0-9][a-z0-9_.-]{7,63}$", "not": {"pattern": ":latest$"}},
    "source_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["dockerfile_sha256", "mix_exs_sha256", "mix_lock_sha256", "config_sha256", "input_bundle_sha256", "config_file_count"],
      "properties": {
        "dockerfile_sha256": {"$ref": "#/$defs/sha256"},
        "mix_exs_sha256": {"$ref": "#/$defs/sha256"},
        "mix_lock_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "input_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "config_file_count": {"type": "integer", "minimum": 1}
      }
    },
    "base": {
      "type": "object", "additionalProperties": false,
      "required": ["index_reference", "index_digest", "platform_reference", "platform_manifest_digest", "expected_config_id", "observed_config_id", "expected_os", "expected_architecture", "index_observed_os", "index_observed_architecture", "platform_observed_os", "platform_observed_architecture", "verified"],
      "properties": {
        "index_reference": {"type": "string", "pattern": "^hexpm/elixir:1\\.18\\.4-erlang-27\\.3\\.4-alpine-3\\.21\\.3@sha256:[a-f0-9]{64}$"},
        "index_digest": {"$ref": "#/$defs/image_id"},
        "platform_reference": {"type": "string", "pattern": "^hexpm/elixir@sha256:[a-f0-9]{64}$"},
        "platform_manifest_digest": {"$ref": "#/$defs/image_id"},
        "expected_config_id": {"$ref": "#/$defs/image_id"},
        "observed_config_id": {"oneOf": [{"$ref": "#/$defs/image_id"}, {"type": "null"}]},
        "expected_os": {"const": "linux"}, "expected_architecture": {"const": "amd64"},
        "index_observed_os": {"type": ["string", "null"]},
        "index_observed_architecture": {"type": ["string", "null"]},
        "platform_observed_os": {"type": ["string", "null"]},
        "platform_observed_architecture": {"type": ["string", "null"]},
        "verified": {"type": "boolean"}
      }
    },
    "tools": {
      "type": "object", "additionalProperties": false,
      "required": ["elixir", "erlang", "otp", "alpine", "hex", "package_manager", "apk_repository_branch", "apk_repositories", "postgresql_client_package", "postgresql_client_package_version", "alpine_toolchain_packages", "psql", "package_manifest_sha256"],
      "properties": {
        "elixir": {"const": "1.18.4"}, "erlang": {"const": "27.3.4"}, "otp": {"const": "27"},
        "alpine": {"const": "3.21.3"}, "hex": {"const": "2.2.1"},
        "package_manager": {"const": "apk"}, "apk_repository_branch": {"const": "v3.21"},
        "apk_repositories": {
          "type": "array", "prefixItems": [
            {"const": "https://dl-cdn.alpinelinux.org/alpine/v3.21/main"},
            {"const": "https://dl-cdn.alpinelinux.org/alpine/v3.21/community"}
          ], "minItems": 2, "maxItems": 2
        },
        "postgresql_client_package": {"const": "postgresql16-client"},
        "postgresql_client_package_version": {"const": "16.14-r0"},
        "alpine_toolchain_packages": {
          "type": "array", "prefixItems": [
            {"const": "build-base"}, {"const": "git"}, {"const": "python3"},
            {"const": "pkgconf"}, {"const": "openssl-dev"}, {"const": "libxml2-dev"}
          ], "minItems": 6, "maxItems": 6
        },
        "psql": {"const": "16.14"}, "package_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["full_id", "observed_os", "observed_architecture", "labels_verified", "post_build_verified"],
      "properties": {
        "full_id": {"oneOf": [{"$ref": "#/$defs/image_id"}, {"type": "null"}]},
        "observed_os": {"type": ["string", "null"]},
        "observed_architecture": {"type": ["string", "null"]},
        "labels_verified": {"type": "boolean"}, "post_build_verified": {"type": "boolean"}
      }
    },
    "build_failure_diagnostic": {
      "oneOf": [{"$ref": "#/$defs/build_failure_diagnostic"}, {"type": "null"}]
    },
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "attempted", "complete", "tag", "image", "residuals"],
      "properties": {
        "required": {"type": "boolean"},
        "attempted": {"type": "boolean"},
        "complete": {"type": "boolean"},
        "tag": {"$ref": "#/$defs/cleanup_resource"},
        "image": {"$ref": "#/$defs/cleanup_resource"},
        "residuals": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["tag", "image"]}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"required": {"const": true}}, "required": ["required"]},
          "then": {"properties": {"attempted": {"const": true}}},
          "else": {"properties": {
            "attempted": {"const": false}, "complete": {"const": true},
            "tag": {"properties": {"attempted": {"const": false}, "outcome": {"const": "not_needed"}}},
            "image": {"properties": {"attempted": {"const": false}, "outcome": {"const": "not_needed"}}},
            "residuals": {"maxItems": 0}
          }}
        },
        {
          "if": {"properties": {"complete": {"const": true}}, "required": ["complete"]},
          "then": {"properties": {
            "tag": {"properties": {"outcome": {"enum": ["removed", "absent", "not_needed"]}}},
            "image": {"properties": {"outcome": {"enum": ["removed", "absent", "not_needed"]}}},
            "residuals": {"maxItems": 0}
          }},
          "else": {"properties": {"residuals": {"minItems": 1}}}
        }
      ]
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["inputs_staged", "inputs_unchanged", "lock_unchanged", "base_id_verified", "base_platform_verified", "tag_absent_before_build", "build_succeeded", "iidfile_verified", "full_image_id_inspected", "final_platform_verified", "tag_resolved_to_full_id", "labels_verified", "network_none_verification", "read_only_verification", "deps_check", "versions_verified", "no_post_build_hydration"],
      "properties": {
        "inputs_staged": {"type": "boolean"}, "inputs_unchanged": {"type": "boolean"},
        "lock_unchanged": {"type": "boolean"}, "base_id_verified": {"type": "boolean"},
        "base_platform_verified": {"type": "boolean"},
        "tag_absent_before_build": {"type": "boolean"},
        "build_succeeded": {"type": "boolean"}, "iidfile_verified": {"type": "boolean"},
        "full_image_id_inspected": {"type": "boolean"}, "final_platform_verified": {"type": "boolean"},
        "tag_resolved_to_full_id": {"type": "boolean"},
        "labels_verified": {"type": "boolean"}, "network_none_verification": {"type": "boolean"},
        "read_only_verification": {"type": "boolean"}, "deps_check": {"type": "boolean"},
        "versions_verified": {"type": "boolean"}, "no_post_build_hydration": {"type": "boolean"}
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["build_verified", "runtime_validation_executed", "runtime_validated", "byte_reproducible", "product_ready", "production_validated", "external_claim_allowed", "vendor_parity"],
      "properties": {
        "build_verified": {"type": "boolean"},
        "runtime_validation_executed": {"const": false}, "runtime_validated": {"const": false},
        "byte_reproducible": {"const": false}, "product_ready": {"const": false},
        "production_validated": {"const": false}, "external_claim_allowed": {"const": false},
        "vendor_parity": {"const": false}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claim_boundary": {"type": "string", "minLength": 80},
    "error": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "image_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "version": {"type": "string", "pattern": "^[0-9][0-9A-Za-z.+:~_-]*$"},
    "cleanup_resource": {
      "type": "object", "additionalProperties": false,
      "required": ["attempted", "outcome", "observed_image_id", "error"],
      "properties": {
        "attempted": {"type": "boolean"},
        "outcome": {"enum": ["not_needed", "removed", "absent", "skipped_preexisting", "skipped_divergent", "failed", "unknown"]},
        "observed_image_id": {"oneOf": [{"$ref": "#/$defs/image_id"}, {"type": "null"}]},
        "error": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      }
    },
    "build_stream_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_bytes", "retained_bytes", "truncated"],
      "properties": {
        "observed_bytes": {"type": "integer", "minimum": 0},
        "retained_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "truncated": {"type": "boolean"}
      }
    },
    "build_step": {
      "type": "object", "additionalProperties": false,
      "required": ["buildkit_id", "index", "total", "stage", "instruction"],
      "properties": {
        "buildkit_id": {"type": "integer", "minimum": 0, "maximum": 999999},
        "index": {"type": "integer", "minimum": 0, "maximum": 9999},
        "total": {"type": "integer", "minimum": 1, "maximum": 9999},
        "stage": {"oneOf": [{"const": "named"}, {"type": "null"}]},
        "instruction": {"enum": ["ARG", "CMD", "COPY", "ENTRYPOINT", "ENV", "FROM", "LABEL", "RUN", "USER", "WORKDIR"]}
      }
    },
    "build_failure_diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["failure_kind", "command_exit_code", "process_exit_code", "error_step_id", "step", "warnings", "canonical_tail", "canonical_tail_sha256", "observed_line_count", "discarded_line_count", "stdout", "stderr"],
      "properties": {
        "failure_kind": {"enum": ["process_exit", "timeout", "adapter_error", "buildkit_error", "unknown"]},
        "failure_checkpoint": {"enum": ["repositories", "apk_install", "psql_version", "closure_digest", "unknown"]},
        "command_exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "process_exit_code": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 255}, {"type": "null"}]},
        "error_step_id": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 999999}, {"type": "null"}]},
        "step": {"oneOf": [{"$ref": "#/$defs/build_step"}, {"type": "null"}]},
        "warnings": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": {"enum": ["ConsistentInstructionCasing", "CopyIgnoredFile", "DuplicateStageName", "ExposeProtoCasing", "FromAsCasing", "FromPlatformFlagConstDisallowed", "InvalidDefaultArgInFrom", "InvalidDefinitionDescription", "JSONArgsRecommended", "LegacyKeyValueFormat", "MaintainerDeprecated", "MultipleInstructionsDisallowed", "NoEmptyContinuation", "Other", "RedundantTargetPlatform", "ReservedStageName", "SecretsUsedInArgOrEnv", "StageNameCasing", "UndefinedArgInFrom", "UndefinedVar", "WorkdirRelativePath"]}
        },
        "canonical_tail": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {
            "type": "string", "maxLength": 96,
            "pattern": "^(step:[0-9]{1,6}:(?:[0-9]{1,4}/[0-9]{1,4}:[A-Z]+|error)|warning:(?:ConsistentInstructionCasing|CopyIgnoredFile|DuplicateStageName|ExposeProtoCasing|FromAsCasing|FromPlatformFlagConstDisallowed|InvalidDefaultArgInFrom|InvalidDefinitionDescription|JSONArgsRecommended|LegacyKeyValueFormat|MaintainerDeprecated|MultipleInstructionsDisallowed|NoEmptyContinuation|Other|RedundantTargetPlatform|ReservedStageName|SecretsUsedInArgOrEnv|StageNameCasing|UndefinedArgInFrom|UndefinedVar|WorkdirRelativePath)|process_exit:[0-9]{1,3}|buildkit_failed_to_solve|adapter_error:[A-Za-z][A-Za-z0-9_]{0,63}|timeout|unknown_failure|checkpoint:(?:repositories|apk_install|psql_version|closure_digest|unknown))$"
          }
        },
        "canonical_tail_sha256": {"$ref": "#/$defs/sha256"},
        "observed_line_count": {"type": "integer", "minimum": 0},
        "discarded_line_count": {"type": "integer", "minimum": 0},
        "stdout": {"$ref": "#/$defs/build_stream_metadata"},
        "stderr": {"$ref": "#/$defs/build_stream_metadata"}
      }
    }
  },
  "oneOf": [
    {
      "required": ["mode", "invocation_id", "tag", "source_sha", "inputs", "base", "tools", "image", "cleanup", "checks", "limitations"],
      "not": {"required": ["error"]}
    },
    {
      "required": ["error"],
      "properties": {
        "status": {"const": "blocked"},
        "claims": {"properties": {"build_verified": {"const": false}}}
      },
      "not": {"anyOf": [
        {"required": ["mode"]}, {"required": ["invocation_id"]}, {"required": ["tag"]},
        {"required": ["source_sha"]}, {"required": ["inputs"]}, {"required": ["base"]},
        {"required": ["tools"]}, {"required": ["image"]}, {"required": ["build_failure_diagnostic"]}, {"required": ["cleanup"]}, {"required": ["checks"]},
        {"required": ["limitations"]}
      ]}
    }
  ],
  "allOf": [
    {
      "if": {"required": ["diagnostic_contract_version"]},
      "then": {"required": ["diagnostic_contract_version", "build_failure_diagnostic"]}
    },
    {
      "if": {
        "properties": {"diagnostic_contract_version": {"const": 2}},
        "required": ["diagnostic_contract_version"]
      },
      "then": {
        "properties": {
          "build_failure_diagnostic": {
            "oneOf": [
              {"type": "null"},
              {"allOf": [
                {"$ref": "#/$defs/build_failure_diagnostic"},
                {"required": ["failure_checkpoint"]},
                {"properties": {"canonical_tail": {
                  "contains": {"pattern": "^checkpoint:"}, "minContains": 1, "maxContains": 1
                }}},
                {"if": {"properties": {"failure_checkpoint": {"const": "repositories"}}},
                 "then": {"properties": {"canonical_tail": {"contains": {"const": "checkpoint:repositories"}}}}},
                {"if": {"properties": {"failure_checkpoint": {"const": "apk_install"}}},
                 "then": {"properties": {"canonical_tail": {"contains": {"const": "checkpoint:apk_install"}}}}},
                {"if": {"properties": {"failure_checkpoint": {"const": "psql_version"}}},
                 "then": {"properties": {"canonical_tail": {"contains": {"const": "checkpoint:psql_version"}}}}},
                {"if": {"properties": {"failure_checkpoint": {"const": "closure_digest"}}},
                 "then": {"properties": {"canonical_tail": {"contains": {"const": "checkpoint:closure_digest"}}}}},
                {"if": {"properties": {"failure_checkpoint": {"const": "unknown"}}},
                 "then": {"properties": {"canonical_tail": {"contains": {"const": "checkpoint:unknown"}}}}}
              ]}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
      "then": {
        "properties": {
          "mode": {"const": "execute"},
          "base": {"properties": {
            "verified": {"const": true}, "observed_config_id": {"$ref": "#/$defs/image_id"},
            "index_observed_os": {"const": "linux"}, "index_observed_architecture": {"const": "amd64"},
            "platform_observed_os": {"const": "linux"}, "platform_observed_architecture": {"const": "amd64"}
          }},
          "image": {"properties": {
            "full_id": {"$ref": "#/$defs/image_id"}, "observed_os": {"const": "linux"},
            "observed_architecture": {"const": "amd64"},
            "labels_verified": {"const": true}, "post_build_verified": {"const": true}
          }},
          "build_failure_diagnostic": {"type": "null"},
          "cleanup": {"properties": {
            "required": {"const": false}, "attempted": {"const": false}, "complete": {"const": true},
            "tag": {"properties": {"attempted": {"const": false}, "outcome": {"const": "not_needed"}}},
            "image": {"properties": {"attempted": {"const": false}, "outcome": {"const": "not_needed"}}},
            "residuals": {"maxItems": 0}
          }},
          "checks": {"properties": {
            "inputs_staged": {"const": true}, "inputs_unchanged": {"const": true}, "lock_unchanged": {"const": true},
            "base_id_verified": {"const": true}, "base_platform_verified": {"const": true}, "tag_absent_before_build": {"const": true}, "build_succeeded": {"const": true}, "iidfile_verified": {"const": true},
            "full_image_id_inspected": {"const": true}, "final_platform_verified": {"const": true}, "tag_resolved_to_full_id": {"const": true},
            "labels_verified": {"const": true}, "network_none_verification": {"const": true}, "read_only_verification": {"const": true},
            "deps_check": {"const": true}, "versions_verified": {"const": true}, "no_post_build_hydration": {"const": true}
          }},
          "claims": {"properties": {"build_verified": {"const": true}}}
        }
      }
    },
    {
      "if": {"properties": {"claims": {"properties": {"build_verified": {"const": true}}, "required": ["build_verified"]}}, "required": ["claims"]},
      "then": {"properties": {"status": {"const": "pass"}}}
    },
    {
      "if": {
        "properties": {"limitations": {"contains": {"const": "docker_build_failed"}}},
        "required": ["limitations"]
      },
      "then": {"properties": {"build_failure_diagnostic": {"$ref": "#/$defs/build_failure_diagnostic"}}}
    },
    {
      "if": {"properties": {"build_failure_diagnostic": {"$ref": "#/$defs/build_failure_diagnostic"}}, "required": ["build_failure_diagnostic"]},
      "then": {"properties": {
        "status": {"const": "blocked"},
        "checks": {"properties": {"build_succeeded": {"const": false}}},
        "claims": {"properties": {"build_verified": {"const": false}}},
        "limitations": {"contains": {"const": "docker_build_failed"}}
      }}
    },
    {
      "if": {
        "properties": {
          "status": {"const": "blocked"},
          "checks": {"properties": {"build_succeeded": {"const": true}}, "required": ["build_succeeded"]}
        },
        "required": ["status", "checks"]
      },
      "then": {"properties": {"cleanup": {"properties": {"required": {"const": true}, "attempted": {"const": true}}}}}
    },
    {
      "if": {"properties": {"cleanup": {"properties": {"required": {"const": true}}, "required": ["required"]}}, "required": ["cleanup"]},
      "then": {"properties": {
        "status": {"const": "blocked"},
        "claims": {"properties": {"build_verified": {"const": false}}}
      }}
    }
  ]
}
