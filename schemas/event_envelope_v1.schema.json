{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.local/schemas/event_envelope_v1.schema.json",
  "title": "Tamandua Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "routing", "event"],
  "properties": {
    "schema_version": {
      "const": "tamandua.io/event-envelope/v1"
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "agent_id",
        "platform",
        "collector_id",
        "event_type",
        "observed_at",
        "ingested_at"
      ],
      "properties": {
        "tenant_id": {"type": "string", "minLength": 1},
        "agent_id": {"type": "string", "minLength": 1},
        "hostname": {"type": "string"},
        "platform": {"enum": ["windows", "linux", "macos", "android", "ios"]},
        "collector_id": {"type": "string", "pattern": "^[a-z0-9_.-]{2,128}$"},
        "event_type": {"type": "string", "pattern": "^[a-z0-9_.-]{2,128}$"},
        "severity_hint": {"enum": ["info", "low", "medium", "high", "critical"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "ingested_at": {"type": "string", "format": "date-time"},
        "source_event_id": {"type": "string"},
        "correlation_id": {"type": "string"},
        "trace_id": {"type": "string"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": true,
      "required": ["category", "action", "outcome"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["success", "failure", "unknown"]},
        "process": {"type": "object"},
        "file": {"type": "object"},
        "network": {"type": "object"},
        "dns": {"type": "object"},
        "registry": {"type": "object"},
        "identity": {
          "type": "object",
          "additionalProperties": true,
          "required": ["provider", "source_event_id"],
          "properties": {
            "provider": {"const": "windows_security_event_log"},
            "source_event_id": {
              "oneOf": [
                {"enum": [4624, 4625, 4648, 4672, 4769]},
                {"enum": ["4624", "4625", "4648", "4672", "4769"]}
              ]
            },
            "subject": {"type": "string"},
            "subject_account": {"type": "string"},
            "subject_domain": {"type": "string"},
            "subject_sid": {"type": ["string", "null"]},
            "target": {"type": ["string", "null"]},
            "target_account": {"type": ["string", "null"]},
            "target_domain": {"type": ["string", "null"]},
            "target_sid": {"type": ["string", "null"]},
            "baseline_key": {"type": "string"},
            "logon_type": {"type": ["integer", "null"]},
            "logon_type_name": {"type": ["string", "null"]},
            "auth_package": {"type": ["string", "null"]},
            "service_name": {"type": ["string", "null"]},
            "failure_reason": {"type": ["string", "null"]},
            "failure_status": {"type": ["string", "null"]},
            "failure_substatus": {"type": ["string", "null"]},
            "risk_indicators": {"type": "array", "items": {"type": "string"}}
          }
        },
        "user": {"type": "object"},
        "host": {"type": "object"},
        "labels": {"type": "array", "items": {"type": "string"}},
        "raw": {"type": "object"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "normalized": {"type": "boolean"},
        "required_fields_present": {"type": "boolean"},
        "dropped_fields": {"type": "array", "items": {"type": "string"}},
        "parser_errors": {"type": "array", "items": {"type": "string"}},
        "collector_health": {"enum": ["healthy", "degraded", "unknown"]}
      }
    }
  }
}
