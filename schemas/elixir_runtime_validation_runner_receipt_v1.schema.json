{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.dev/schemas/elixir_runtime_validation_runner_receipt_v1.schema.json",
  "title": "Tamandua Elixir runtime validation runner build receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "status", "generated_at", "claims", "claim_boundary"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"const": "elixir-only-current-lock-v1"},
    "status": {"enum": ["pass", "blocked"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["inspect", "execute"]},
    "invocation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{7,63}$"},
    "tag": {"type": "string", "maxLength": 255, "not": {"pattern": ":latest$"}},
    "source": {"$ref": "#/$defs/source"},
    "inputs": {"$ref": "#/$defs/inputs"},
    "images": {"$ref": "#/$defs/images"},
    "aliases": {"$ref": "#/$defs/aliases"},
    "artifact": {"$ref": "#/$defs/artifact"},
    "checks": {"$ref": "#/$defs/checks"},
    "cleanup": {"$ref": "#/$defs/cleanup"},
    "diagnostic": {"oneOf": [{"$ref": "#/$defs/diagnostic"}, {"type": "null"}]},
    "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 96}},
    "error": {"type": "string", "pattern": "^[a-z0-9_:.-]{1,160}$"},
    "claims": {"$ref": "#/$defs/claims"},
    "claim_boundary": {"type": "string", "minLength": 32, "maxLength": 1024}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "image_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["head", "dirty", "status_sha256"],
      "properties": {
        "head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "dirty": {"type": "boolean"},
        "status_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["mix_exs_sha256", "mix_lock_sha256", "config_sha256", "config_file_count", "dockerfile_sha256", "helper_sha256", "schema_sha256", "bundle_sha256"],
      "properties": {
        "mix_exs_sha256": {"$ref": "#/$defs/sha256"},
        "mix_lock_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "config_file_count": {"type": "integer", "minimum": 1},
        "dockerfile_sha256": {"$ref": "#/$defs/sha256"},
        "helper_sha256": {"$ref": "#/$defs/sha256"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "image_input": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_id", "observed_id", "rootfs_sha256", "os", "architecture", "verified", "preexisting_references"],
      "properties": {
        "expected_id": {"$ref": "#/$defs/image_id"},
        "observed_id": {"oneOf": [{"$ref": "#/$defs/image_id"}, {"type": "null"}]},
        "rootfs_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "os": {"oneOf": [{"const": "linux"}, {"type": "null"}]},
        "architecture": {"oneOf": [{"const": "amd64"}, {"type": "null"}]},
        "verified": {"type": "boolean"},
        "preexisting_references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 255}}
      }
    },
    "images": {
      "type": "object", "additionalProperties": false,
      "required": ["hydrator", "final_base"],
      "properties": {
        "hydrator": {"allOf": [
          {"$ref": "#/$defs/image_input"},
          {"properties": {"expected_id": {"const": "sha256:f31484716c92e442efbe163ff5df3456ac6dd3e0c96a2c3d1cc4fd295661e5a0"}}}
        ]},
        "final_base": {"allOf": [
          {"$ref": "#/$defs/image_input"},
          {"properties": {"expected_id": {"const": "sha256:b825e4efea9c3296ffec1e065b5f56eb385654dec0c81ba70d72a481b81e4de9"}}}
        ]}
      }
    },
    "alias": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "expected_id", "observed_id", "created", "stable"],
      "properties": {
        "reference": {"type": "string", "pattern": "^tamandua/elixir-runtime-validation-base:(?:hydrator|final)-[a-f0-9]{12}-[a-z0-9][a-z0-9_.-]{7,63}$", "not": {"pattern": ":latest$"}},
        "expected_id": {"$ref": "#/$defs/image_id"},
        "observed_id": {"oneOf": [{"$ref": "#/$defs/image_id"}, {"type": "null"}]},
        "created": {"type": "boolean"}, "stable": {"type": "boolean"}
      }
    },
    "aliases": {
      "type": "object", "additionalProperties": false, "required": ["hydrator", "final_base"],
      "properties": {
        "hydrator": {"allOf": [
          {"$ref": "#/$defs/alias"},
          {"properties": {
            "reference": {"pattern": "^tamandua/elixir-runtime-validation-base:hydrator-[a-f0-9]{12}-[a-z0-9][a-z0-9_.-]{7,63}$"},
            "expected_id": {"const": "sha256:f31484716c92e442efbe163ff5df3456ac6dd3e0c96a2c3d1cc4fd295661e5a0"}
          }}
        ]},
        "final_base": {"allOf": [
          {"$ref": "#/$defs/alias"},
          {"properties": {
            "reference": {"pattern": "^tamandua/elixir-runtime-validation-base:final-[a-f0-9]{12}-[a-z0-9][a-z0-9_.-]{7,63}$"},
            "expected_id": {"const": "sha256:b825e4efea9c3296ffec1e065b5f56eb385654dec0c81ba70d72a481b81e4de9"}
          }}
        ]}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["full_id", "rootfs_sha256", "labels_verified", "final_base_lineage_verified", "postverify_output_sha256"],
      "properties": {
        "full_id": {"oneOf": [{"$ref": "#/$defs/image_id"}, {"type": "null"}]},
        "rootfs_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "labels_verified": {"type": "boolean"},
        "final_base_lineage_verified": {"type": "boolean"},
        "postverify_output_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["inputs_staged", "inputs_unchanged", "dependency_sources_hex_only", "bases_verified", "base_rootfs_lineage", "aliases_absent", "aliases_created", "alias_ids_stable", "tag_absent", "build_succeeded", "iid_verified", "labels_verified", "final_base_lineage", "hydrator_layers_excluded", "tag_removed", "aliases_removed", "base_images_preserved", "network_none_postverify", "read_only_postverify", "lock_unchanged", "deps_check", "psql_absent", "nif_closure"],
      "properties": {
        "inputs_staged": {"type": "boolean"},
        "inputs_unchanged": {"type": "boolean"},
        "dependency_sources_hex_only": {"type": "boolean"},
        "bases_verified": {"type": "boolean"},
        "base_rootfs_lineage": {"type": "boolean"},
        "aliases_absent": {"type": "boolean"},
        "aliases_created": {"type": "boolean"},
        "alias_ids_stable": {"type": "boolean"},
        "tag_absent": {"type": "boolean"},
        "build_succeeded": {"type": "boolean"},
        "iid_verified": {"type": "boolean"},
        "labels_verified": {"type": "boolean"},
        "final_base_lineage": {"type": "boolean"},
        "hydrator_layers_excluded": {"type": "boolean"},
        "tag_removed": {"type": "boolean"},
        "aliases_removed": {"type": "boolean"},
        "base_images_preserved": {"type": "boolean"},
        "network_none_postverify": {"type": "boolean"},
        "read_only_postverify": {"type": "boolean"},
        "lock_unchanged": {"type": "boolean"},
        "deps_check": {"type": "boolean"},
        "psql_absent": {"type": "boolean"},
        "nif_closure": {"type": "boolean"}
      }
    },
    "cleanup_resource": {
      "type": "object", "additionalProperties": false,
      "required": ["attempted", "outcome"],
      "properties": {
        "attempted": {"type": "boolean"},
        "outcome": {"enum": ["not_needed", "absent", "removed", "retained_full_id", "skipped_preexisting", "skipped_unowned", "unknown"]},
        "observed_id": {"oneOf": [{"$ref": "#/$defs/image_id"}, {"type": "null"}]}
      }
    },
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "complete", "tag", "image", "hydrator_alias", "final_base_alias", "residuals"],
      "properties": {
        "required": {"type": "boolean"}, "complete": {"type": "boolean"},
        "tag": {"$ref": "#/$defs/cleanup_resource"}, "image": {"$ref": "#/$defs/cleanup_resource"},
        "hydrator_alias": {"$ref": "#/$defs/cleanup_resource"}, "final_base_alias": {"$ref": "#/$defs/cleanup_resource"},
        "residuals": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 160}}
      },
      "allOf": [
        {
          "if": {"properties": {"complete": {"const": true}}, "required": ["complete"]},
          "then": {"properties": {"residuals": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"complete": {"const": false}}, "required": ["complete"]},
          "then": {"properties": {"residuals": {"minItems": 1}}}
        }
      ]
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "category", "exit_code", "canonical_tail", "canonical_tail_sha256", "observed_bytes", "discarded_bytes"],
      "properties": {
        "kind": {"enum": ["buildkit", "process_exit", "timeout", "adapter", "unknown"]},
        "category": {"enum": ["base_reference_resolution", "dependency_fetch_failed", "dependency_lock_guard_failed", "other"]},
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "canonical_tail": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "pattern": "^(step:[0-9]{1,6}:(?:[0-9]{1,4}/[0-9]{1,4}:[A-Z]+|error)|warning:[A-Za-z][A-Za-z0-9_-]{0,63}|process_exit:[0-9]{1,3}|buildkit_failed|base_reference_resolution|dependency_fetch_failed|dependency_fetch_succeeded|dependency_lock_guard_failed|timeout|adapter_error|unknown_failure)$", "maxLength": 96}},
        "canonical_tail_sha256": {"$ref": "#/$defs/sha256"},
        "observed_bytes": {"type": "integer", "minimum": 0},
        "discarded_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_verified", "byte_reproducible", "runtime_validation_executed", "rls_validated", "inbox_unlocked", "product_ready", "production_validated", "external_claim_allowed", "vendor_parity"],
      "properties": {
        "artifact_verified": {"type": "boolean"},
        "byte_reproducible": {"const": false}, "runtime_validation_executed": {"const": false},
        "rls_validated": {"const": false}, "inbox_unlocked": {"const": false},
        "product_ready": {"const": false}, "production_validated": {"const": false},
        "external_claim_allowed": {"const": false}, "vendor_parity": {"const": false}
      }
    }
  },
  "oneOf": [
    {
      "required": ["mode", "invocation_id", "tag", "source", "inputs", "images", "aliases", "artifact", "checks", "cleanup", "diagnostic", "limitations"],
      "not": {"required": ["error"]}
    },
    {
      "required": ["error"],
      "properties": {"status": {"const": "blocked"}, "claims": {"properties": {"artifact_verified": {"const": false}}}},
      "not": {"anyOf": [{"required": ["mode"]}, {"required": ["inputs"]}, {"required": ["artifact"]}, {"required": ["checks"]}]}
    }
  ],
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
      "then": {
        "properties": {
          "mode": {"const": "execute"}, "diagnostic": {"type": "null"},
          "images": {"properties": {
            "hydrator": {"properties": {"verified": {"const": true}, "preexisting_references": {"minItems": 1}}},
            "final_base": {"properties": {"verified": {"const": true}, "preexisting_references": {"minItems": 1}}}
          }},
          "aliases": {"properties": {
            "hydrator": {"properties": {"observed_id": {"$ref": "#/$defs/image_id"}, "created": {"const": true}, "stable": {"const": true}}},
            "final_base": {"properties": {"observed_id": {"$ref": "#/$defs/image_id"}, "created": {"const": true}, "stable": {"const": true}}}
          }},
          "artifact": {"properties": {"full_id": {"$ref": "#/$defs/image_id"}, "labels_verified": {"const": true}, "final_base_lineage_verified": {"const": true}, "postverify_output_sha256": {"$ref": "#/$defs/sha256"}}},
          "checks": {
            "properties": {
              "inputs_staged": {"const": true}, "inputs_unchanged": {"const": true},
              "dependency_sources_hex_only": {"const": true}, "bases_verified": {"const": true},
              "base_rootfs_lineage": {"const": true}, "tag_absent": {"const": true},
              "aliases_absent": {"const": true}, "aliases_created": {"const": true}, "alias_ids_stable": {"const": true},
              "build_succeeded": {"const": true}, "iid_verified": {"const": true},
              "labels_verified": {"const": true}, "final_base_lineage": {"const": true},
              "hydrator_layers_excluded": {"const": true}, "tag_removed": {"const": true},
              "aliases_removed": {"const": true}, "base_images_preserved": {"const": true},
              "network_none_postverify": {"const": true}, "read_only_postverify": {"const": true},
              "lock_unchanged": {"const": true}, "deps_check": {"const": true},
              "psql_absent": {"const": true}, "nif_closure": {"const": true}
            }
          },
          "cleanup": {"properties": {"complete": {"const": true}, "tag": {"properties": {"outcome": {"const": "removed"}}}, "image": {"properties": {"outcome": {"const": "retained_full_id"}}}, "hydrator_alias": {"properties": {"outcome": {"const": "removed"}}}, "final_base_alias": {"properties": {"outcome": {"const": "removed"}}}, "residuals": {"maxItems": 0}}},
          "claims": {"properties": {"artifact_verified": {"const": true}}}
        }
      }
    },
    {
      "if": {"properties": {"claims": {"properties": {"artifact_verified": {"const": true}}, "required": ["artifact_verified"]}}, "required": ["claims"]},
      "then": {"properties": {"status": {"const": "pass"}}}
    }
  ]
}
